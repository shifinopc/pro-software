# Files that run inside Linux containers must keep LF, whatever the checkout platform does.
# A shell script with CRLF fails as "bad interpreter: /bin/sh^M" — an error that says nothing about
# line endings and costs an hour to recognise.
*.sh            text eol=lf
Dockerfile*     text eol=lf
docker/*        text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
