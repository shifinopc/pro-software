# Dependencies
node_modules/
.pnpm-store/

# Build output — regenerated by `pnpm build`
dist/
server/dist/

# Deploy artifacts — regenerated by the build scripts; large and duplicate the source
deploy/api/
deploy/console/
deploy/portal/
*.zip

# SECRETS — never commit.
# server/.env holds DATABASE_URL, JWT_SECRET and CRED_KEY (the AES key that decrypts the client
# credential vault: government-portal logins). Use server/.env.example as the template.
.env
server/.env
*.pem
*.key

# Client-uploaded files: passports, licences, letterheads. Real people's documents.
server/uploads-files/
server/uploads/

# Local tooling / scratch
# `.claude/*` not `.claude/` — git cannot re-include anything inside an excluded
# DIRECTORY, so the skills negation below only works if the directory itself is
# not ignored. Project skills are shared knowledge about how to work on this repo
# and travel with it; settings.local.json, caches and the rest stay local.
.claude/*
!.claude/skills/
.DS_Store
Thumbs.db
*.log

# Pasted design screenshots. Referenced by no code, and they show the LIVE app: real company names,
# contact emails, employee names and document expiry dates. Never publish these.
public/uploads/
