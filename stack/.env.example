# STIMES PRO — copy to .env beside your compose invocation and fill in.
# Never commit the filled version.
#
# Generate the two secrets on the server:
#   docker run --rm node:22-bookworm-slim node -e "const c=require('crypto');console.log('JWT_SECRET='+c.randomBytes(48).toString('hex'));console.log('CRED_KEY='+c.randomBytes(32).toString('hex'))"

# ── Database ────────────────────────────────────────────────────────────────
# This database belongs to this stack alone. It is not the SEO stack's MySQL and must not
# point at it — they hold unrelated schemas and would fight over the same tables.
DB_NAME=stimespro
DB_USER=stimespro
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Secrets ─────────────────────────────────────────────────────────────────
# The API refuses to start in production if either is missing or left at a dev default.
JWT_SECRET=

# CRED_KEY must decode to exactly 32 bytes (64 hex characters) — the AES-256 key for the client
# credential vault. RECORD IT SOMEWHERE OFF THIS BOX. If it is lost or changed, every credential
# stored for every client becomes permanently unreadable. There is no recovery path.
CRED_KEY=

# ── Email (optional) ────────────────────────────────────────────────────────
# Without it the app runs fine but sends nothing: no invoice emails, no renewal notices, no portal
# invitations. Each of those flows will report success and quietly do nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="STIMES PRO <no-reply@ionob.in>"
