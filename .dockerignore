# Keep the build context small and, more importantly, keep secrets and host-built artefacts out of
# the image.
node_modules
server/node_modules
dist
server/dist
deploy
.git
.claude

# Never copy a real environment file into an image.
.env
*.env
server/.env
!.env.example
!server/.env.example

# Uploaded client documents belong in a volume, not baked into an image.
public/uploads
server/uploads-files
