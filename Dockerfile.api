# STIMES PRO — API (Express + Prisma + MySQL)
#
# Debian rather than Alpine on purpose: prisma/schema.prisma declares
# binaryTargets ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]. Alpine is musl and would
# need "linux-musl-openssl-3.0.x" adding to that list — a schema change to suit the base image,
# which is the wrong way round. bookworm-slim matches a target that is already there.
#
# Single stage, deliberately. The entrypoint runs `prisma db push` and the operator runs the seed
# through `tsx`, and both are devDependencies — a runtime stage carrying only production deps could
# start the API but could not create or seed the database it needs.
FROM node:22-bookworm-slim

# openssl: Prisma's query engine links against it. ca-certificates: outbound TLS (SMTP).
#
# libreoffice-writer turns a generated proposal into a PDF — for the preview the console already
# knows how to show, and so a client can be sent something they cannot accidentally edit. Writer
# alone, not the suite: the full libreoffice package drags in Calc, Impress, Draw and Java for
# several times the size, and nothing here opens a spreadsheet. The font packages are not optional
# decoration — without them Writer substitutes whatever it can find, and the firm's typography,
# which is the entire reason their own .docx is the template, changes on the way to PDF.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssl ca-certificates \
      libreoffice-writer \
      fonts-liberation fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first so a code-only change does not reinstall them.
COPY server/package*.json ./
RUN npm ci

COPY server/ ./

# Country packs. They live at the repo root, outside server/, so without this line the image has no
# packs at all and the install screen comes up empty on the server while working fine in dev.
#
# NOT ./packs/ — that path is a named volume in the deployed stack, and a named volume is seeded from
# the image only when it is first created. Copying here meant every corrected pack shipped after the
# first deploy was invisible on the server forever. The volume keeps runtime uploads; this is the
# image's own read-only copy, and packs.ts lists both.
COPY packs/ ./packs-builtin/

# Generate the client and compile to dist/. Both are build-time so a container restart is instant.
RUN npx prisma generate && npm run build

# Uploaded documents live here and are served at /files/<name>. Declared so it is obvious this path
# MUST be a volume — without one, every client's uploads are destroyed by the next image rebuild.
# uploads-private/ holds identity documents and is NOT served: it is reachable only through
# /api/files/:id, which checks who is asking. Same volume rule, same reason.
RUN mkdir -p /app/uploads-files /app/uploads-private
VOLUME ["/app/uploads-files", "/app/uploads-private"]

COPY docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh

ENV NODE_ENV=production
ENV PORT=4100
EXPOSE 4100

ENTRYPOINT ["/usr/local/bin/api-entrypoint.sh"]
CMD ["node", "dist/index.js"]
