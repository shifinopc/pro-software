# ── STIMES PRO API — environment ──
# Copy to `.env` on the server and fill in real values.

# MySQL connection. URL-encode special chars in the password (@ -> %40).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/stimespro"

# Port the Node process listens on (put a reverse proxy in front for HTTPS).
PORT=4100

# Secrets — GENERATE NEW ONES for production. Do NOT reuse the dev values.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   -> JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   -> CRED_KEY (MUST be 32 bytes / 64 hex chars — encrypts the credential vault)
JWT_SECRET="change-me-to-a-long-random-string"
CRED_KEY="change-me-to-a-64-hex-char-string"

# Comma-separated list of allowed browser origins (the console + portal).
# Local dev defaults are built in; set this in production.
CORS_ORIGINS="https://pro.ionob.in,https://cp.ionob.in"

# Base URLs used in password-reset emails (link targets).
CONSOLE_URL="https://pro.ionob.in"
PORTAL_URL="https://cp.ionob.in"

# Email delivery (optional). If unset, reset links are logged to the server console instead of sent.
# Run `npm run gen-secrets` to generate JWT_SECRET + CRED_KEY above.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="STIMES PRO <no-reply@ionob.in>"

# ── Salesperson mailbox (Sales -> Inbox) ──────────────────────────────────────────────────────
#
# Lets each member of staff connect their OWN mailbox, so a client's reply lands on the client's
# record instead of only in somebody's personal inbox. Leave empty and the feature stays off.
#
# Only metadata is ever stored — who wrote, to whom, the subject and when — and only for messages
# whose counterparty is already a contact or company in this system. Message bodies are never
# written down; the Inbox drawer reads them from the provider at the moment somebody opens them.
#
# GOOGLE: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web).
#   Scopes: gmail.readonly, email.
#   WHILE THE APP IS IN "TESTING", GOOGLE EXPIRES EVERY REFRESH TOKEN AFTER 7 DAYS, so each person
#   has to reconnect weekly until the app is published and verified. That is Google's rule, not a
#   bug here; the Inbox reports it as "needs reconnecting" rather than failing silently.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# MICROSOFT 365: entra.microsoft.com -> App registrations. Scopes: Mail.Read, User.Read,
# offline_access. MS_TENANT_ID can be `common` for any work or personal account.
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT_ID=""

# Must match the redirect URI registered with the provider character for character, including the
# scheme and any trailing path. Defaults to the local API when unset.
#   local  http://localhost:4100/api/mailbox/callback
#   live   https://proapi.ionob.in/api/mailbox/callback
OAUTH_REDIRECT_URI=""

# Connects the agents (Configure -> Agents) to Claude. Get a key at console.anthropic.com.
# Leave empty for no model. Never commit a real key.
ANTHROPIC_API_KEY=""

# A self-hosted model on any OpenAI-compatible server (llama.cpp `llama-server`, vLLM, a GPU box).
# Configured here, not in the console, on purpose: where identity documents are sent is a security
# decision, and an address in the database could be changed by anyone who got into an admin account.
# Reach it over a private link (WireGuard) — never expose the model server's port to the internet.
#   llama-server -m qwen3.5-4b-q4_k_m.gguf --mmproj mmproj.gguf --host 10.8.0.2 --port 8080 --api-key <long-random> --jinja
OPENAI_COMPAT_BASE_URL=""      # e.g. http://10.8.0.2:8080/v1
OPENAI_COMPAT_API_KEY=""       # the --api-key given to llama-server
OPENAI_COMPAT_MODELS=""        # comma-separated names it serves, e.g. qwen3.5-4b
OPENAI_COMPAT_LABEL=""         # shown on screen, e.g. Office model server
OPENAI_COMPAT_TIMEOUT_MS=""    # default 240000; a CPU-only server can take minutes per scan

# Built-in passport reader (no model): OCR workers kept warm while the scan dialog is open.
# Each adds ~130 MB. 1 reads a passport in ~2 s, 2 in ~1.5 s.
PASSPORT_OCR_WORKERS="1"

# ── Cloudflare cache purge, run as the last step of every deploy (stack/purge-cdn.sh) ─────────
#
# The console is one 3.7 MB document held at the edge for an hour. Without a purge, a deploy is
# live at the origin and invisible to users for up to that hour — a reload gets the cached copy.
# Measured cost of turning the edge cache off instead: page loads went from 0.8 s to 2.6 s.
#
# The token needs ONE permission and nothing else: Zone → Cache Purge → Purge, on ionob.in. It
# cannot read DNS, change a rule or reach another zone. Make it at
# https://dash.cloudflare.com/profile/api-tokens → Create Token → Custom token.
# The zone id is on the Cloudflare overview page for ionob.in, right-hand column.
CF_ZONE_ID=""
CF_PURGE_TOKEN=""
