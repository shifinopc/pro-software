/// A piece of business being pursued — the thing a pipeline is made of.
///
/// WHY THE MONEY LIVES SOMEWHERE ELSE ONCE A QUOTATION EXISTS
///
/// `valueMinor` is an ESTIMATE, and only while nobody has quoted. The moment a quotation is raised
/// from this opportunity the quotation's figures are the ones of record, and this reads them rather
/// than keeping its own — otherwise the board says SAR 40,000, the quotation says SAR 38,500, and
/// there is no way to tell which one a forecast was built from.
///
/// WHY THERE IS NO `status` COLUMN
///
/// Open, won and lost are not a second thing to record: they are what the CURRENT STAGE means. A
/// stored status is a copy of the stage, and the two disagree the first time somebody drags a card
/// without the handler that maintains both — which is exactly the class of bug this codebase keeps
/// finding. `isWon`/`isLost` on the stage are the single answer.
model Opportunity {
  id                String        @id @default(cuid())
  /// Reference (OPP-0001) from the configured record sequence, so it can be quoted in an email.
  number            String?
  company           Company       @relation(fields: [companyId], references: [id])
  companyId         String
  /// Who at that company is driving it. Nullable — early on, often nobody is known yet.
  contactId         String?
  title             String
  /// The estimate, in minor units, while no quotation exists. Never rounded to whole riyals: the
  /// same reason Invoice and Quotation hold minor units.
  valueMinor        Int?
  currency          String?
  /// Per-deal odds, overriding the stage's default when somebody knows better. Basis points.
  probabilityBp     Int?
  /// FORECAST CATEGORY — "commit" | "best_case" | "pipeline", or NULL for "derive it from the odds".
  ///
  /// The fourth dimension of a deal, separate from all three others: the STAGE is where it sits in
  /// the process, HEALTH is how it is doing, the NEXT ACTION is what happens next — and this is
  /// whether its money may be promised upward. Two deals can share a stage while one is committed
  /// and the other is a long shot, which is exactly the distinction a stage cannot carry.
  ///
  /// Null is the normal state and means DERIVED (see forecastOf in pipeline.ts): the same
  /// override-the-derivation pattern as probabilityBp above, and for the same reason — a person who
  /// has met the client knows more than a threshold, but only sometimes, and a column that had to
  /// be set on every deal would mostly be stale.
  forecastCategory  String?
  /// Who this deal is up against. Free text with a suggested master (model Competitor) — the same
  /// suggest-don't-constrain contract as lostReason, and most useful ON a loss: "lost to Odoo on
  /// price" is one row in two columns.
  competitor        String?
  stage             PipelineStage @relation(fields: [stageId], references: [id])
  stageId           String
  expectedCloseDate String?
  ownerId           String?
  source            String?
  /// Required by the API when moving into a losing stage. A loss with no reason recorded makes the
  /// one report that could improve next quarter worthless.
  lostReason        String?
  /// The quotation raised from this opportunity, if any. Its acceptance is what wins the deal —
  /// see startDeliveryForQuotation, which is the single place both accept paths run through.
  quotationId       String?
  country           String?
  notes             String?       @db.Text
  /// The stage's checklist, SNAPSHOT on entering the stage. Editing a stage's rule afterwards must
  /// not retroactively change what a deal in flight was asked for — the same reason a workflow task
  /// snapshots its checklist rather than reading the template live.
  checklist         Json?
  /// MANUAL ticks only, keyed by item key. Document items are deliberately absent: they are derived
  /// from the documents that actually exist, so a stored tick could disagree with reality and the
  /// stored one would win. Nothing here can be true about a document.
  checklistState    Json?
  /// A required item let through by an admin, with the reason. Without an escape a deal can be stuck
  /// for ever behind an item that no longer applies, and the only way out is the database. A waived
  /// item counts as done and is reported as WAIVED, never as satisfied.
  checklistWaived   Json?
  /// What raised this deal automatically, if anything did — "renewal:<subscriptionId>:<endDate>".
  ///
  /// UNIQUE, and that is the whole point: the hourly tick re-reads the same expiring subscription
  /// every hour, and a find-then-create would race with itself into duplicates. The index IS the
  /// dedupe, the same trick `notifyOnce` uses. NULL for deals a person opened, and MySQL permits
  /// any number of NULLs in a unique index, so hand-made deals are unaffected.
  originKey         String?       @unique
  createdAt         String?
  /// When it entered the stage it is in now, so "sitting in Quoted for 40 days" is answerable.
  stageAt           String?
  closedAt          String?

  interactions Interaction[]

  @@index([companyId])
  @@index([stageId])
  @@index([ownerId])
}

/// What somebody is expected to sell in a period.
///
/// A target is the DENOMINATOR that makes every other sales figure mean something: "SAR 180,000 won"
/// is a fact, and whether it is a good quarter is not answerable without this.
///
/// Progress against it is never stored. It is the value of the deals won inside the period, counted
/// when asked — a stamped "72% achieved" would be wrong the moment the next deal closed, and would
/// need a write on every win to stay true.
model SalesTarget {
  id          String  @id @default(cuid())
  /// "2026-08" for a month, "2026-Q3" for a quarter. Text rather than a date range because that is
  /// how the target is actually set and spoken about, and a range invites two rows that overlap.
  period      String
  /// Whose target. NULL means the whole firm — the two are different questions and both get asked,
  /// so neither is derived from the other.
  ownerId     String?
  /// A TEAM's target, for the same reason a person's is not derived from the firm's: a lead is asked
  /// what their team will bring in, and that is not the sum of what each member was individually
  /// asked for. Exactly one of ownerId / teamId is set, or neither for the firm — enforced in the
  /// route rather than the schema, because "at most one of these" has no column-level expression.
  teamId      String?
  amountMinor Int
  currency    String?
  country     String?
  note        String?
  createdAt   String?

  @@unique([period, ownerId, teamId])
  @@index([period])
}

/// Something that happened with a client, and what was promised next.
///
/// TWO TENSES IN ONE ROW, ON PURPOSE
///
/// `at` + `summary` are the PAST: the call that happened, what was said. `nextAction` +
/// `nextActionAt` are the FUTURE: what you undertook to do about it. They belong together because
/// that is how the commitment is actually made — "I'll send the quote on Sunday" is said during the
/// call, and splitting it into a separate to-do record is how the two drift apart, leaving a task
/// nobody can trace to a conversation and a conversation with no consequence.
///
/// A follow-up is OPEN while `nextActionAt` is set and `nextActionDoneAt` is not. That is the whole
/// definition — there is no status column, for the same reason an opportunity has none.
///
/// Deliberately not called an Activity: `Activity` already exists in this schema as the system's own
/// audit feed, written by the login path. Two things called activity, one of them meaning "a person
/// picked up the phone", is a vocabulary collision the reader would pay for every time.
model Interaction {
  id               String       @id @default(cuid())
  company          Company      @relation(fields: [companyId], references: [id])
  companyId        String
  /// Who was spoken to. Nullable — a note about the company as a whole names nobody.
  contactId        String?
  /// The deal it was about, if it was about one. Nullable: plenty of contact is relationship rather
  /// than pipeline, and forcing every call to hang off an opportunity invents deals to hold notes.
  opportunity      Opportunity? @relation(fields: [opportunityId], references: [id])
  opportunityId    String?
  /// call | meeting | email | whatsapp | note | site_visit
  kind             String       @default("call")
  /// When it HAPPENED, which is not when it was typed in. Somebody logging Thursday's call on
  /// Monday would otherwise put it in the wrong week of every report.
  at               String
  summary          String?      @db.Text
  /// How it went, in the logger's words. Free text: a picker here would be a list of outcomes that
  /// is wrong for the second kind of business the firm does.
  outcome          String?
  nextAction       String?
  nextActionAt     String?
  nextActionDoneAt String?
  // ── Cancelled is not Done ───────────────────────────────────────────────────────────────────
  //
  // `nextActionDoneAt` used to carry both meanings, and they are different facts: "I made the call"
  // and "the client says this is no longer needed" should not read the same in a completion figure.
  // Conflating them also pushed people towards logging a fake interaction to clear the queue, which
  // corrupts the contact log as well as the count.
  //
  // Two nullable dates rather than a `status` string, so the state stays DERIVED and cannot
  // contradict itself the way `status: "done"` beside a null completion date could:
  //   both null      → open
  //   nextActionDoneAt → done
  //   cancelledAt      → cancelled
  cancelledAt      String?
  /// Why it was abandoned. Required by the route — a cancellation with no reason teaches nothing,
  /// and "why did forty of these get dropped last month" is the question that earns the column.
  cancelReason     String?
  /// Who owes it. Defaults to whoever logged it, because an unassigned commitment is nobody's.
  ownerId          String?
  /// True when a stage rule booked this rather than a person typing it.
  ///
  /// The distinction earns its column: moving a deal on CLEARS the previous stage's chase, and it
  /// must only ever clear its own. A commitment somebody made to a client by hand — "I promised to
  /// call Fahad on Sunday" — survives every stage move, because nothing in a pipeline knows better
  /// than the person who made the promise.
  auto             Boolean      @default(false)
  // ── Snooze: pushing a commitment, with the push left visible ────────────────────────────────
  //
  // Moving a date used to mean closing the commitment and logging a new one, which loses the fact
  // that it moved at all. These three columns keep it: how MANY times it has been pushed, what it
  // was FIRST due, and the last reason given.
  //
  // The count is the point. One postponement is ordinary; a follow-up pushed five times is not a
  // scheduling fact, it is somebody avoiding a call — and that only becomes visible if the pushes
  // accumulate somewhere instead of each one overwriting the last.
  //
  // Deliberately three columns rather than a SnoozeEvent table, unlike the stage/lifecycle/owner
  // histories added elsewhere. Those answer analytical questions ACROSS many records over time;
  // this answers one question about one commitment — "how long has this been dodged, and since
  // when" — which compresses to a count and a date with no loss of the actionable signal.
  /// How many times the due date has been pushed. Never reset — that is what makes it a signal.
  snoozeCount      Int          @default(0)
  /// What it was FIRST due, set on the first snooze only, so repeated pushes cannot erase the origin.
  snoozedFrom      String?
  /// Why it was last pushed. Optional: demanding a reason turns a snooze into a form people avoid,
  /// and an avoided snooze becomes an ignored overdue row, which is strictly worse.
  snoozeReason     String?
  createdAt        String?

  @@index([companyId])
  @@index([opportunityId])
  @@index([nextActionAt])
  @@index([ownerId])
}

model ChecklistRule {
  id           String  @id @default(cuid())
  // Provenance, for rows that came from a country pack.
  //
  // packKey is the stable identity a pack uses — sa.doctype.iqama — so a re-install recognises this
  // row instead of creating a second one, and an upgrade can find what it is upgrading. Deliberately
  // INDEXED rather than @unique: a unique constraint is the change Prisma refuses without
  // --accept-data-loss, which crash-looped the live API earlier today. The installer enforces
  // uniqueness itself, and pays for that with a check rather than an outage.
  //
  // packModified means a human has edited this since it was installed, so an upgrade must show a diff
  // Retired by a pack uninstall, NOT deleted.
  //
  // A document type with documents captured under it cannot be removed — the documents would lose the
  // definition of their own fields, which is the orphaning this codebase has already been bitten by.
  // So uninstall retires what real records depend on: gone from every picker, still readable, so a
  // two-year-old Iqama still renders with its fields intact.
  retired      Boolean @default(false)
  // rather than overwrite. Null packKey = made here, owned by you, never touched by a pack.
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)
  // Which country this belongs to. Configuration was implicitly Saudi everywhere; with a second
  // country pack installed, an unmarked row appears in every client's pickers regardless of the
  // market they operate in. Nullable for existing rows, backfilled to SA, defaulted on create.
  country      String?
  name         String
  rows         Json?   @default("[]")

  @@index([packKey])
}

model WorkflowLog {
  id         String           @id @default(cuid())
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id])
  instanceId String
  nodeId     String?
  action     String
  detail     String?          @db.Text
  actor      String?
  at         String
}

// Org-wide settings (console Settings → General etc.) — one JSON row per area, keyed ("org", …).
model AppSetting {
  key   String @id
  value Json
}

// ── Operations masters (Government Centers / Appointments / Courier) ──
model GovCenter {
  id           String  @id @default(cuid())
  // Provenance, for rows that came from a country pack.
  //
  // packKey is the stable identity a pack uses — sa.doctype.iqama — so a re-install recognises this
  // row instead of creating a second one, and an upgrade can find what it is upgrading. Deliberately
  // INDEXED rather than @unique: a unique constraint is the change Prisma refuses without
  // --accept-data-loss, which crash-looped the live API earlier today. The installer enforces
  // uniqueness itself, and pays for that with a check rather than an outage.
  //
  // packModified means a human has edited this since it was installed, so an upgrade must show a diff
  // Retired by a pack uninstall, NOT deleted.
  //
  // A document type with documents captured under it cannot be removed — the documents would lose the
  // definition of their own fields, which is the orphaning this codebase has already been bitten by.
  // So uninstall retires what real records depend on: gone from every picker, still readable, so a
  // two-year-old Iqama still renders with its fields intact.
  retired      Boolean @default(false)
  // rather than overwrite. Null packKey = made here, owned by you, never touched by a pack.
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)
  name         String
  // Which country's authority this is. Country Rules used to hold its own typed list of portals
  // ("MOL, Absher, Muqeem, Qiwa") beside this table, and the two already disagreed — this one is
  // real, because the step picker, the Government Centers queue and the credential link all read it.
  // With a country on the row, that screen can show the true list instead of keeping a second one.
  country      String?
  sub          String? // what it handles
  color        String?
  bg           String?
  officer      String? // default owning officer
  pending      Int     @default(0)
  submitted    Int     @default(0)
  approved     Int     @default(0)
  rejected     Int     @default(0)

  @@index([packKey])
}

model Appointment {
  id                String  @id @default(cuid())
  title             String
  type              String? // Medical test / Biometrics / ...
  companyId         String?
  clientName        String?
  employee          String?
  location          String?
  date              String?
  time              String?
  status            String  @default("scheduled") // Requested | Confirmed | Rescheduled | Attended | No-show | Cancelled
  notes             String?
  history           Json?   @default("[]") // audit trail: [{ at, by, event, detail }] from creation onward
  taskId            String? // optional link to the Task this meeting belongs to (shown on the task)
  // Client-requested reschedule awaiting STAFF approval: { date, time, note, by, at }.
  // Approve (console) applies date/time + history; decline just clears it. Null = none pending.
  pendingReschedule Json?

  @@index([companyId])
  @@index([status])
}

model CourierShipment {
  id          String  @id @default(cuid())
  ref         String
  description String?
  companyId   String?
  clientName  String?
  carrier     String?
  direction   String  @default("outbound") // outbound | inbound
  status      String  @default("in_transit") // preparing | in_transit | delivered | returned
  eta         String?
  at          String?
  // What is in the envelope, and what it belongs to.
  //
  // A shipment used to be a bare row: a reference, a carrier and a status. So a renewed passport went
  // out and the document had no idea where it was — "where is that passport" could only be answered by
  // remembering which shipment it was in. Appointments already carried a taskId; courier was the one
  // left out of the chain.
  documentId  String?
  taskId      String?

  @@index([companyId])
  @@index([documentId])
  @@index([taskId])
}

// ── Money: payments received against invoices; quotations before invoicing ──
model Payment {
  id            String  @id @default(cuid())
  // Receipt number (RCP-2026-001) from the configured record sequence. `reference` is the client's
  // bank/cheque reference and is a different thing entirely — this is OUR document number.
  number        String?
  invoiceId     String?
  invoiceNumber String?
  companyId     String?
  clientName    String?
  amount        Int
  method        String? // bank transfer / card / cash
  reference     String?
  date          String?
  notes         String?

  @@index([companyId])
  @@index([invoiceId])
  @@index([date])
}

model Quotation {
  id            String  @id @default(cuid())
  number        String
  companyId     String?
  clientName    String?
  service       String?
  amount        Int     @default(0)
  // Same minor-unit figures as Invoice, and for the same reason: `amount Int` cannot hold halala, so
  // the gross used to be rounded to a whole riyal on save and the RATE reverse-engineered at print
  // time — which printed "VAT 20%" on a SAR 10 line. Frozen here at issue, and carried straight
  // through to the invoice on convert so the two documents cannot disagree.
  subtotalMinor Int? // 25000 = SAR 250.00
  vatMinor      Int?
  totalMinor    Int?
  vatRateBp     Int? // basis points: 1500 = 15.00%
  // Line items [{ name, units, price }] — mirrors Invoice.items. `amount` stays the total of record.
  items         Json?   @default("[]")
  // draft    — being written, console only
  // approved — signed off internally, ready to send; still console only
  // sent     — released; the first state the client can see
  // accepted — the CLIENT agreed to it
  // rejected — the client declined
  // invoiced — an invoice has been raised from it
  status        String  @default("draft")
  date          String?
  /// When it was actually RELEASED to the client, which is not the same as `date`.
  ///
  /// `date` is the issue date printed on the document, set when the row is created. A quotation
  /// drafted on the 1st and sent on the 20th carries the 1st — so chasing on `date` would announce
  /// "no answer for 19 days" the moment somebody pressed Send. Stamped on the transition to `sent`,
  /// in the one place that transition is detected.
  sentAt        String?
  validUntil    String?
  notes         String?
  // What the client asked to be changed, when they send it back instead of accepting. Kept apart
  // from `notes`, which is printed ON the quotation — this is correspondence, not document content.
  clientNote    String? @db.Text

  @@index([companyId])
  @@index([status])
}

// ── Service catalog (gov fee + service fee per offered service) ──
model ServiceItem {
  id           String  @id @default(cuid())
  // Provenance, for rows that came from a country pack.
  //
  // packKey is the stable identity a pack uses — sa.doctype.iqama — so a re-install recognises this
  // row instead of creating a second one, and an upgrade can find what it is upgrading. Deliberately
  // INDEXED rather than @unique: a unique constraint is the change Prisma refuses without
  // --accept-data-loss, which crash-looped the live API earlier today. The installer enforces
  // uniqueness itself, and pays for that with a check rather than an outage.
  //
  // packModified means a human has edited this since it was installed, so an upgrade must show a diff
  // Retired by a pack uninstall, NOT deleted.
  //
  // A document type with documents captured under it cannot be removed — the documents would lose the
  // definition of their own fields, which is the orphaning this codebase has already been bitten by.
  // So uninstall retires what real records depend on: gone from every picker, still readable, so a
  // two-year-old Iqama still renders with its fields intact.
  retired      Boolean @default(false)
  // rather than overwrite. Null packKey = made here, owned by you, never touched by a pack.
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)
  // Which country this belongs to. Configuration was implicitly Saudi everywhere; with a second
  // country pack installed, an unmarked row appears in every client's pickers regardless of the
  // market they operate in. Nullable for existing rows, backfilled to SA, defaulted on create.
  country      String?
  name         String
  govFee       Int     @default(0)
  serviceFee   Int     @default(0)
  time         String? // "3–5 days"
  sla          String? // "5 working days"
  docs         Int     @default(0)
  included     Boolean @default(true) // included in base plans vs premium
  docType      String? // document it produces
  workflowId   String? // bound workflow template
  // WHAT THE CLIENT MUST SUPPLY — the single source of truth, read by the portal request wizard
  // (one upload slot per entry) AND by a workflow collect step configured checklistSource:"service".
  // Four places used to claim this knowledge and none agreed: a hardcoded sentence in the portal
  // ("passport copy, photo, existing permit") shown for all fourteen services, a `docs` COUNT nobody
  // derived, each step's own checklist, and ChecklistRule. Empty means "not configured yet" and the
  // portal falls back to a free-form box — it does NOT mean "no documents needed".
  // [{ key, label, required, hint }]
  requiredDocs Json?   @default("[]")

  @@index([packKey])
}

// ── API keys (programmatic access) + uploaded file registry ──
model ApiKey {
  id         String  @id @default(cuid())
  name       String
  prefix     String // first chars shown in lists
  keyHash    String // sha256 of the full key — full key returned only once at creation
  // What the key may do: "read" resolves to pro_officer (GET only), "write" to admin. A key never
  // resolves to super_admin, and never passes requireHuman — it cannot mint keys, read the
  // credential vault, or manage users however it is scoped.
  scope      String  @default("read")
  createdAt  String
  lastUsedAt String?
  revoked    Boolean @default(false)
}

model FileAsset {
  id         String  @id @default(cuid())
  kind       String // org-logo | login-logo | document | attachment
  name       String
  // Where to fetch it. Branding assets keep a public /files/<random> path so an <img> tag can load
  // them without a token. Anything holding a person's identity documents is stored OUTSIDE the
  // served folder and its path is /api/files/<id>, which checks who is asking — see `private`.
  path       String
  size       Int     @default(0)
  uploadedBy String?
  // Who the file belongs to. Set for client uploads; null for staff/branding uploads, which only
  // staff may read. This is the whole basis of the access check on /api/files/:id.
  companyId  String?
  private    Boolean @default(false)
  at         String

  @@index([kind])
}

// Something a user hit that they could not act on: a dead URL, a crash, or a problem they chose to
// report by hand. Deliberately relation-free — a report must be storable even when the context it
// came from is partial (signed out, unknown company, a screen that failed before it had data).
model ErrorReport {
  id        String  @id @default(cuid())
  kind      String  @default("manual") // not_found | crash | manual
  app       String  @default("console") // console | portal
  path      String?
  message   String? @db.Text
  detail    String? @db.Text // stack or extra context
  userAgent String? @db.Text
  actorId   String?
  actorName String?
  companyId String?
  note      String? @db.Text // what the user typed
  status    String  @default("new") // new | seen | closed
  createdAt String?

  @@index([status])
}

/// One line waiting to go into somebody's daily digest.
///
/// Owner-addressed reminders are QUEUED here instead of being sent one at a time when digest mode is
/// on. It has to be a table rather than something derived: `Notification` is a single global bell
/// with no recipient column, so there is nothing in it that says who each row was for.
model DigestItem {
  id     String  @id @default(cuid())
  email  String // the recipient, resolved at queue time — ownership can change before the digest goes
  rule   String // the RuleKey it came from, so the digest can group by it
  title  String  @db.Text
  detail String? @db.Text
  url    String?
  /// True when this reached them only because nobody owns the record. Said out loud in the digest.
  orphan Boolean @default(false)

  createdAt String
  sentAt    String? // null = still waiting

  @@index([email, sentAt])
}

/// One digest actually sent. The unique index IS the guard — the insert either wins or throws, so two
/// overlapping ticks cannot both mail somebody the same morning. Same trick as Notification.dedupeKey.
model DigestRun {
  id     String @id @default(cuid())
  email  String
  day    String // YYYY-MM-DD in the ORGANISATION's timezone, not the server's
  items  Int
  sentAt String

  @@unique([email, day])
}

/// Every attempt to send an email, and what happened to it.
///
/// Failures used to go to `console.error` and nowhere else: `deliver()` swallowed them so a mail
/// outage could not break a write path — correct — but that meant a client's invoice notice could
/// fail silently forever and the only symptom was somebody eventually saying "I never got that".
///
/// Written from inside `sendMail`, so nothing that sends can avoid being recorded.
model MailLog {
  id      String  @id @default(cuid())
  to      String
  subject String  @db.Text
  /// sent | failed | skipped  (skipped = sending is switched off, which is not a fault)
  status  String
  /// What kind of message it was — the rule key, "invitation", "password reset"… for reading the log.
  kind    String?
  /// The transport's own words. Kept verbatim: "Invalid from" and "auth failed" need different fixes.
  error   String? @db.Text
  at      String

  @@index([status, at])
  @@index([at])
}

/// WHO GETS THIS PIECE OF WORK.
///
/// Both halves of the system already answered that question, and both answered it the same way:
/// whoever is carrying the least. `rotation()` picks the lightest salesperson for a new lead;
/// `pickAssignee()` picks the lightest holder of a role for a workflow task. Load balancing is the
/// right DEFAULT — it needs no maintenance and self-corrects — but it is the wrong and only answer
/// when the work is not interchangeable. An officer who does Qiwa all day is faster at Qiwa. A rep
/// who knows company formation closes more of it. Neither fact could be expressed anywhere.
///
/// So: an ordered list of rules, first match wins, and NO MATCH FALLS BACK TO THE LOAD BALANCER.
/// That last part is what makes this safe to add to a working system — an empty rule list behaves
/// exactly as today, and a rule can only ever redirect work that was going to be handed out anyway.
///
/// One table for both sides deliberately. "Leads from the website go to Fahad" and "GOSI steps go to
/// Noura" are the same sentence about different nouns, and splitting them into two features would
/// give the firm two places to look and two sets of behaviour to remember.
///
/// A rule never overrides a human. The workflow ladder still puts a step's own named assignee first,
/// and a lead somebody has already claimed is not reassigned — rules fill empty owners, like the
/// rotation they refine.
model AssignmentRule {
  id       String  @id @default(cuid())
  /// lead | task — which side of the business this rule routes.
  scope    String
  /// First match wins, so order is the rule. Lower runs first.
  position Int     @default(0)
  active   Boolean @default(true)
  /// What a human calls this rule, for the list and for the audit line.
  label    String

  /// CONDITIONS. Every one is optional and an unset condition matches anything, so a rule with no
  /// conditions at all is a catch-all — useful as the last row, dangerous as the first, which is why
  /// the editor shows position and the resolver explains which rule fired.
  whenSource    String? /// lead: where it came from — Website, Referral…
  whenCity      String? /// lead: territory, matched case-insensitively
  whenCountry   String? /// both: SA, AE…
  whenGovCenter String? /// task: the authority the step is done at
  whenService   String? /// both: the service being sold or delivered

  /// TARGET. A person, or a role to balance within. Exactly one is meant to be set; the resolver
  /// prefers toUserId when both are, because naming a person is the more specific instruction.
  toUserId String?
  toRole   String?

  createdAt String?
  updatedAt String?

  @@index([scope, active, position])
}

/// A LINK SOMEBODY OUTSIDE THIS SYSTEM CAN BOOK TIME THROUGH.
///
/// The alternative it replaces is four emails deciding on one meeting. A rep sends the link, the
/// client picks a time that is genuinely free, and the appointment, the lead and the logged
/// interaction all exist without anybody retyping them.
///
/// THE LIMIT THIS CANNOT HIDE. "Free" here means free *according to this system*. Until a rep's own
/// calendar is connected, a meeting that lives only in their Google Calendar is invisible to slot
/// generation and will be offered. That is a real double-booking risk, it is stated on the screen
/// where links are made, and it is the strongest argument for doing the mailbox/calendar work next.
///
/// Availability is a WEEKLY SHAPE, not a list of dates. Storing dates would need somebody to keep
/// extending them, and a booking page that quietly runs out of slots looks broken rather than full.
model BookingLink {
  id     String  @id @default(cuid())
  /// The staff member being booked. Their name is what the visitor sees.
  userId String
  /// The public part of the URL: /book/<slug>. Unique, and never reused after deletion — an old
  /// link landing on somebody else's diary is worse than an old link that plainly does not work.
  slug   String  @unique
  /// What the visitor is booking, in their words: "Free 30-minute consultation".
  title  String
  blurb  String? @db.Text

  active      Boolean @default(true)
  /// Length of the meeting, and the gap enforced after one before the next may start.
  minutes     Int     @default(30)
  bufferMins  Int     @default(0)
  /// Working hours, in the ORGANISATION's timezone. 9 → 17 means the last 30-minute slot is 16:30.
  dayStart    Int     @default(9)
  dayEnd      Int     @default(17)
  /// Which days are workable, as ISO weekday numbers (1 = Monday … 7 = Sunday). Saudi Arabia's
  /// working week is Sunday–Thursday, so this is NOT a Monday–Friday default.
  workDays    String  @default("7,1,2,3,4")
  /// How far ahead the page offers, and how much notice is required before the earliest slot.
  daysAhead   Int     @default(14)
  noticeHours Int     @default(4)

  createdAt String?
  updatedAt String?

  @@index([userId])
}

/// A REP'S OWN MAILBOX, CONNECTED.
///
/// The point is that a client's reply lands on their record without anybody copying it there, and
/// that mail a rep sends goes out from THEIR address so the reply comes back to them — not to a
/// shared no-reply nobody watches.
///
/// TOKENS, NOT PASSWORDS. Encrypted with CRED_KEY, the same envelope the government-portal vault
/// uses. A token can be revoked by the person who granted it, from their own provider account,
/// without telling us — which is the property that makes this acceptable to hand over in the first
/// place. Passwords have none of that, which is why per-user SMTP was rejected.
///
/// ONE ROW PER PERSON. Nobody connects two mailboxes: two would mean deciding which one a reply
/// belongs to, and there is no honest answer to that.
model MailboxConnection {
  id       String @id @default(cuid())
  userId   String @unique
  /// google | microsoft — which adapter reads it. See mailbox.ts for why this is a thin seam.
  provider String
  /// The address that was actually connected, shown so somebody can tell which account they granted.
  address  String

  /// AES-GCM, CRED_KEY. Never returned by any route, ever — not even redacted.
  accessTokenEnc  String  @db.Text
  refreshTokenEnc String? @db.Text
  /// When the access token dies. Refreshed ahead of this, not after a 401 — a sync that only
  /// recovers from failure spends every cycle failing first.
  expiresAt       String?

  /// Where the last sync got to. Provider-specific opaque string (Gmail historyId, Graph deltaLink).
  /// Kept because a full re-read of a mailbox on every tick is both slow and a privacy problem.
  cursor     String? @db.Text
  lastSyncAt String?
  /// The transport's own words when a sync failed. Surfaced rather than swallowed: a mailbox that
  /// silently stopped syncing looks exactly like a client who stopped writing.
  lastError  String? @db.Text
  status     String  @default("active") // active | needs_reconnect | disconnected

  createdAt String?
  updatedAt String?
}

/// ONE EMAIL, ATTACHED TO THE RECORD IT IS ABOUT.
///
/// SCOPED ON PURPOSE. Only messages whose counterparty matches a Contact or Company already in this
/// system are stored. A rep's payslip, their doctor, their job hunt — none of it is matched, so
/// none of it is written. That filter is the whole ethical basis for reading a person's mailbox at
/// all, and it is applied BEFORE the row exists rather than as a query on top of one.
///
/// The BODY IS NOT STORED. A subject line and the participants are enough to answer "did they
/// reply, and when" — which is the question this feature exists for. Storing bodies would turn a
/// CRM into a mail archive with a different threat model and a different conversation with staff.
model EmailMessage {
  id         String @id @default(cuid())
  /// Whose mailbox it came from. A message can legitimately exist twice — two reps on one thread —
  /// and the pair below is what keeps those distinct instead of one overwriting the other.
  userId     String
  /// The provider's own id for the message.
  externalId String
  /// The provider's thread/conversation id — what makes a reply a reply.
  threadId   String

  companyId String?
  contactId String?

  direction    String // in | out
  subject      String? @db.Text
  /// The other side's address. Ours is on the connection, so storing it again would be a second copy.
  counterparty String
  sentAt       String

  createdAt String?

  @@unique([userId, externalId])
  @@index([companyId, sentAt])
  @@index([threadId])
}
