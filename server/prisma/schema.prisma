model WorkflowLog {
  id         String           @id @default(cuid())
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id])
  instanceId String
  nodeId     String?
  action     String
  detail     String?          @db.Text
  actor      String?
  at         String
}

// Org-wide settings (console Settings → General etc.) — one JSON row per area, keyed ("org", …).
model AppSetting {
  key   String @id
  value Json
}

// ── Operations masters (Government Centers / Appointments / Courier) ──
model GovCenter {
  id        String  @id @default(cuid())
  // Provenance, for rows that came from a country pack.
  //
  // packKey is the stable identity a pack uses — sa.doctype.iqama — so a re-install recognises this
  // row instead of creating a second one, and an upgrade can find what it is upgrading. Deliberately
  // INDEXED rather than @unique: a unique constraint is the change Prisma refuses without
  // --accept-data-loss, which crash-looped the live API earlier today. The installer enforces
  // uniqueness itself, and pays for that with a check rather than an outage.
  //
  // packModified means a human has edited this since it was installed, so an upgrade must show a diff
  // Retired by a pack uninstall, NOT deleted.
  //
  // A document type with documents captured under it cannot be removed — the documents would lose the
  // definition of their own fields, which is the orphaning this codebase has already been bitten by.
  // So uninstall retires what real records depend on: gone from every picker, still readable, so a
  // two-year-old Iqama still renders with its fields intact.
  retired      Boolean @default(false)
  // rather than overwrite. Null packKey = made here, owned by you, never touched by a pack.
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)
  name      String
  // Which country's authority this is. Country Rules used to hold its own typed list of portals
  // ("MOL, Absher, Muqeem, Qiwa") beside this table, and the two already disagreed — this one is
  // real, because the step picker, the Government Centers queue and the credential link all read it.
  // With a country on the row, that screen can show the true list instead of keeping a second one.
  country   String?
  sub       String? // what it handles
  color     String?
  bg        String?
  officer   String? // default owning officer
  pending   Int     @default(0)
  submitted Int     @default(0)
  approved  Int     @default(0)
  rejected  Int     @default(0)

  @@index([packKey])
}

model Appointment {
  id         String  @id @default(cuid())
  title      String
  type       String? // Medical test / Biometrics / ...
  companyId  String?
  clientName String?
  employee   String?
  location   String?
  date       String?
  time       String?
  status     String  @default("scheduled") // Requested | Confirmed | Rescheduled | Attended | No-show | Cancelled
  notes      String?
  history    Json?   @default("[]") // audit trail: [{ at, by, event, detail }] from creation onward
  taskId     String? // optional link to the Task this meeting belongs to (shown on the task)
  // Client-requested reschedule awaiting STAFF approval: { date, time, note, by, at }.
  // Approve (console) applies date/time + history; decline just clears it. Null = none pending.
  pendingReschedule Json?

  @@index([companyId])
  @@index([status])
}

model CourierShipment {
  id         String  @id @default(cuid())
  ref        String
  description String?
  companyId  String?
  clientName String?
  carrier    String?
  direction  String  @default("outbound") // outbound | inbound
  status     String  @default("in_transit") // preparing | in_transit | delivered | returned
  eta        String?
  at         String?
  // What is in the envelope, and what it belongs to.
  //
  // A shipment used to be a bare row: a reference, a carrier and a status. So a renewed passport went
  // out and the document had no idea where it was — "where is that passport" could only be answered by
  // remembering which shipment it was in. Appointments already carried a taskId; courier was the one
  // left out of the chain.
  documentId String?
  taskId     String?

  @@index([companyId])
  @@index([documentId])
  @@index([taskId])
}

// ── Money: payments received against invoices; quotations before invoicing ──
model Payment {
  id            String  @id @default(cuid())
  // Receipt number (RCP-2026-001) from the configured record sequence. `reference` is the client's
  // bank/cheque reference and is a different thing entirely — this is OUR document number.
  number        String?
  invoiceId     String?
  invoiceNumber String?
  companyId     String?
  clientName    String?
  amount        Int
  method        String? // bank transfer / card / cash
  reference     String?
  date          String?
  notes         String?

  @@index([companyId])
  @@index([invoiceId])
  @@index([date])
}

model Quotation {
  id         String  @id @default(cuid())
  number     String
  companyId  String?
  clientName String?
  service    String?
  amount     Int     @default(0)
  // Same minor-unit figures as Invoice, and for the same reason: `amount Int` cannot hold halala, so
  // the gross used to be rounded to a whole riyal on save and the RATE reverse-engineered at print
  // time — which printed "VAT 20%" on a SAR 10 line. Frozen here at issue, and carried straight
  // through to the invoice on convert so the two documents cannot disagree.
  subtotalMinor Int? // 25000 = SAR 250.00
  vatMinor      Int?
  totalMinor    Int?
  vatRateBp     Int? // basis points: 1500 = 15.00%
  // Line items [{ name, units, price }] — mirrors Invoice.items. `amount` stays the total of record.
  items      Json?   @default("[]")
  // draft    — being written, console only
  // approved — signed off internally, ready to send; still console only
  // sent     — released; the first state the client can see
  // accepted — the CLIENT agreed to it
  // rejected — the client declined
  // invoiced — an invoice has been raised from it
  status     String  @default("draft")
  date       String?
  validUntil String?
  notes      String?
  // What the client asked to be changed, when they send it back instead of accepting. Kept apart
  // from `notes`, which is printed ON the quotation — this is correspondence, not document content.
  clientNote String? @db.Text

  @@index([companyId])
  @@index([status])
}

// ── Service catalog (gov fee + service fee per offered service) ──
model ServiceItem {
  id         String  @id @default(cuid())
  // Provenance, for rows that came from a country pack.
  //
  // packKey is the stable identity a pack uses — sa.doctype.iqama — so a re-install recognises this
  // row instead of creating a second one, and an upgrade can find what it is upgrading. Deliberately
  // INDEXED rather than @unique: a unique constraint is the change Prisma refuses without
  // --accept-data-loss, which crash-looped the live API earlier today. The installer enforces
  // uniqueness itself, and pays for that with a check rather than an outage.
  //
  // packModified means a human has edited this since it was installed, so an upgrade must show a diff
  // Retired by a pack uninstall, NOT deleted.
  //
  // A document type with documents captured under it cannot be removed — the documents would lose the
  // definition of their own fields, which is the orphaning this codebase has already been bitten by.
  // So uninstall retires what real records depend on: gone from every picker, still readable, so a
  // two-year-old Iqama still renders with its fields intact.
  retired      Boolean @default(false)
  // rather than overwrite. Null packKey = made here, owned by you, never touched by a pack.
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)
  // Which country this belongs to. Configuration was implicitly Saudi everywhere; with a second
  // country pack installed, an unmarked row appears in every client's pickers regardless of the
  // market they operate in. Nullable for existing rows, backfilled to SA, defaulted on create.
  country       String?
  name       String
  govFee     Int     @default(0)
  serviceFee Int     @default(0)
  time       String? // "3–5 days"
  sla        String? // "5 working days"
  docs       Int     @default(0)
  included   Boolean @default(true) // included in base plans vs premium
  docType    String? // document it produces
  workflowId String? // bound workflow template
  // WHAT THE CLIENT MUST SUPPLY — the single source of truth, read by the portal request wizard
  // (one upload slot per entry) AND by a workflow collect step configured checklistSource:"service".
  // Four places used to claim this knowledge and none agreed: a hardcoded sentence in the portal
  // ("passport copy, photo, existing permit") shown for all fourteen services, a `docs` COUNT nobody
  // derived, each step's own checklist, and ChecklistRule. Empty means "not configured yet" and the
  // portal falls back to a free-form box — it does NOT mean "no documents needed".
  // [{ key, label, required, hint }]
  requiredDocs Json? @default("[]")

  @@index([packKey])
}

// ── API keys (programmatic access) + uploaded file registry ──
model ApiKey {
  id         String  @id @default(cuid())
  name       String
  prefix     String // first chars shown in lists
  keyHash    String // sha256 of the full key — full key returned only once at creation
  // What the key may do: "read" resolves to pro_officer (GET only), "write" to admin. A key never
  // resolves to super_admin, and never passes requireHuman — it cannot mint keys, read the
  // credential vault, or manage users however it is scoped.
  scope      String  @default("read")
  createdAt  String
  lastUsedAt String?
  revoked    Boolean @default(false)
}

model FileAsset {
  id         String @id @default(cuid())
  kind       String // org-logo | login-logo | document | attachment
  name       String
  // Where to fetch it. Branding assets keep a public /files/<random> path so an <img> tag can load
  // them without a token. Anything holding a person's identity documents is stored OUTSIDE the
  // served folder and its path is /api/files/<id>, which checks who is asking — see `private`.
  path       String
  size       Int    @default(0)
  uploadedBy String?
  // Who the file belongs to. Set for client uploads; null for staff/branding uploads, which only
  // staff may read. This is the whole basis of the access check on /api/files/:id.
  companyId  String?
  private    Boolean @default(false)
  at         String

  @@index([kind])
}

// Something a user hit that they could not act on: a dead URL, a crash, or a problem they chose to
// report by hand. Deliberately relation-free — a report must be storable even when the context it
// came from is partial (signed out, unknown company, a screen that failed before it had data).
model ErrorReport {
  id        String  @id @default(cuid())
  kind      String  @default("manual") // not_found | crash | manual
  app       String  @default("console") // console | portal
  path      String?
  message   String? @db.Text
  detail    String? @db.Text // stack or extra context
  userAgent String? @db.Text
  actorId   String?
  actorName String?
  companyId String?
  note      String? @db.Text // what the user typed
  status    String  @default("new") // new | seen | closed
  createdAt String?

  @@index([status])
}
