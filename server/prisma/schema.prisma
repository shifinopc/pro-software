// STIMES PRO — data model (mirrors the frontend built model)
generator client {
  provider      = "prisma-client-js"
  // "native" = your dev OS; the others cover common Linux shared hosts (Debian/Ubuntu, RHEL/CloudLinux)
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ClientGroup {
  id        String    @id @default(cuid())
  name      String
  contact   String?
  email     String?
  companies Company[]
}

model Company {
  id        String  @id @default(cuid())
  name      String
  /// Commercial registration. NULLABLE since leads exist.
  ///
  /// This was required, which is correct for a client and impossible for a prospect: a company you
  /// are still pitching has not given you its CR, and demanding one to save the record is what
  /// pushes people into typing "0000" — a fake number that then looks exactly like a real one.
  /// Captured at the moment the lead becomes a client instead; see `lifecycle`.
  cr        String?
  industry  String?
  employees Int     @default(0)
  status    String  @default("active")
  overdue   Int     @default(0)
  expiring  Int     @default(0)
  contact   String?
  email     String?
  phone     String?
  city      String?

  // ── CRM: the same record before it is a client ──────────────────────────────────────────────
  //
  // lead → prospect → client, and out again to lost (never bought) or churned (did, then left).
  //
  // ONE record, not a Lead table that gets "converted" into a Company. Conversion is where CRMs
  // rot: the convert step copies some fields, misses others, and leaves two rows for one company,
  // so the phone number is right on one and stale on the other and nobody can tell which. A record
  // that only ever changes state has no copy step to get wrong, and the history from the first
  // cold call through the tenth invoice stays on one timeline.
  //
  // The price of that decision, stated because it is real: every screen that means CLIENT must now
  // say so. A lead with no employees would otherwise sit in the Saudization report at 0%, be billed
  // by the renewal job, and be counted as a client on the dashboard.
  lifecycle     String        @default("client")
  /// Who owns the relationship — the staff user's id.
  ///
  /// This IS ownership now. It replaced a JSON array on the user, which meant answering "who owns
  /// this client?" required loading every user and scanning their arrays, and nothing prevented two
  /// people holding the same id. NULL means unassigned, which is a state worth seeing rather than a
  /// blank: the `sales` role sees exactly the clients whose ownerId is theirs, so an unowned client
  /// is invisible to every salesperson until somebody claims it.
  ownerId       String?
  /// Where it came from — referral, website, walk-in, campaign. `sourceDetail` holds the specifics
  /// ("referred by Al Rajhi HR"), because a source you cannot ask a follow-up question about is
  /// worth very little when deciding where the next riyal of marketing goes.
  source        String?
  sourceDetail  String?
  /// Which marketing effort generated this lead, when one did. Optional always — most leads are
  /// not the fruit of a campaign, and forcing an answer would fill the column with fiction.
  campaign      String?
  /// Why it was lost. Only meaningful with lifecycle `lost` or `churned`, and the single most
  /// useful field on this model for anyone trying to sell better next quarter.
  lostReason    String?
  // `nextFollowUpAt` used to be here, meant to hold the next dated commitment to this company. It
  // is gone: it would have been a copy of the earliest open follow-up in the interaction log, and a
  // copy needs a second write to stay true — so the first follow-up closed without touching it
  // would leave a company reading "call them Sunday" forever. Asked of the log instead.
  contacts      Contact[]
  opportunities Opportunity[]
  interactions  Interaction[]

  // Which country's law this client operates under. ISO 3166-1 alpha-2.
  //
  // Nothing in the product had a concept of country: every rule, document type and threshold was
  // implicitly Saudi. That is fine for one market and is the first thing in the way of a second one,
  // because there is nowhere to hang "this client is judged by UAE rules, not Saudi ones". Nullable
  // so existing rows are valid; backfilled to SA, which is what every one of them is.
  country              String?
  // Workforce nationalisation — Saudization here, Emiratisation next door, the same shape either way.
  //
  // The RATIO is computed from employee records and never stored: a stored percentage is wrong the
  // moment somebody is hired. The BAND is the opposite — it is not ours to compute. Its thresholds
  // are published per economic activity and per size bracket, so calculating one here would mean
  // inventing a table and announcing "Green" while the official portal says otherwise. It is recorded
  // instead: read on the portal, written down, dated, with the ratio AT THAT MOMENT captured beside it
  // so drift since is measurable. `workforceBandNote` says where it was read.
  // ── Qualification: what was learned before calling this a real opportunity ──────────────────
  //
  // Captured at PROMOTION (lead → prospect), never demanded at arrival: a website enquiry should
  // not have to state a budget to become a lead, and a form that asks gets "0" typed into it.
  // These are relationship-level facts — what the company needs, who decides, what they spend
  // today — so they live here rather than on any one opportunity; the deal opened at promotion is
  // PRE-FILLED from them (budget → estimate, decision date → expected close) and owns its copies
  // from then on, exactly like the stage checklist snapshot.
  /// What the customer actually needs, in the qualifier's words.
  qualRequirement     String? @db.Text
  /// What they said they could spend. Minor units, like every other money column.
  qualBudgetMinor     Int?
  /// When they expect to decide — ISO day.
  qualDecisionBy      String?
  /// Who decides — a Contact id, so the decision maker is a person on file, not a retyped name.
  qualDecisionMakerId String?
  /// What they use today ("Excel", "Odoo", "a PRO on WhatsApp") — the thing being displaced.
  qualCurrentSolution String?
  /// low | medium | high. The qualifier's judgement, not a computed score.
  qualPriority        String?
  /// When qualification was recorded, so "qualified three weeks ago, still no deal" is askable.
  qualAt              String?

  workforceBand        String?
  workforceBandAt      String?
  workforceBandNote    String?
  workforceBandRatioBp Int?
  /// The last band the SYSTEM computed for this client, and when it noticed.
  ///
  /// Separate from workforceBand (what a human read on the portal): this is how a CHANGE is detected
  /// at all. Without it every tick would either re-announce the same band forever or announce nothing,
  /// and "this client dropped out of Green" — the one thing worth interrupting somebody for — could
  /// never be said.
  workforceBandSeen    String?
  workforceBandSeenAt  String?
  // Billing suspension. `status` carries "suspended"; these record why and since when so the console
  // and the client's banner can both explain it rather than just showing a red badge.
  suspendedAt          String?
  suspendedReason      String?
  customData           Json? // values for admin-defined custom client fields (Form Builder)
  // When this client was taken on. Deliberately nullable with NO default: existing rows genuinely
  // do not know, and stamping them all with the migration date would replace one fabrication
  // ("Client since 2024", picked from a hardcoded array by row position) with a tidier one.
  createdAt            String?
  group                ClientGroup?     @relation(fields: [groupId], references: [id])
  groupId              String?
  employeeList         Employee[]
  documents            Document[]
  credentials          SiteCredential[]
  invoices             Invoice[]
  tasks                Task[]
  subscriptions        Subscription[]
  upgradeRequests      UpgradeRequest[]

  @@index([status])
  @@index([lifecycle])
  @@index([ownerId])
}

/// A person at a company, rather than a company's one phone number.
///
/// `Company.contact/email/phone` held exactly one human: a name, an address and a number, with no
/// room for the fact that the HR manager approves the visa, the PRO collects the passport and the
/// owner signs the quotation. Those three get called about different things, and writing the second
/// one down meant overwriting the first.
///
/// Those three columns still exist and still work. They are now a MIRROR of whichever contact is
/// primary, written by one server-side function and by nothing else — see `syncPrimaryContact`.
/// Kept rather than dropped because eight places read them, including the portal-login provisioner
/// and the invoice recipient list; a mirror with a single writer is honest, two editable copies
/// would not be.
model Contact {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id])
  companyId String
  name      String
  /// What they do, in their words — "HR Manager", "PRO", "Owner". Free text on purpose: a picker
  /// here would be a list of titles that is wrong in the second country the product reaches.
  jobTitle  String?
  email     String?
  phone     String?
  /// Kept apart from `phone` because in this market it usually is a different number, and sending
  /// a document to the wrong one means it is not read.
  whatsapp  String?
  /// Exactly one per company, enforced server-side on write rather than by a constraint: the
  /// constraint would have to be dropped and re-added on every re-assignment.
  isPrimary Boolean @default(false)
  /// The portal login this person holds, if they have one. Links the two identities instead of
  /// keeping a second address book that drifts from the first.
  userId    String?
  notes     String? @db.Text
  archived  Boolean @default(false)
  createdAt String?

  @@index([companyId])
  @@index([email])
}

model Package {
  id            String         @id @default(cuid())
  // Provenance, for rows that came from a country pack.
  //
  // packKey is the stable identity a pack uses — sa.doctype.iqama — so a re-install recognises this
  // row instead of creating a second one, and an upgrade can find what it is upgrading. Deliberately
  // INDEXED rather than @unique: a unique constraint is the change Prisma refuses without
  // --accept-data-loss, which crash-looped the live API earlier today. The installer enforces
  // uniqueness itself, and pays for that with a check rather than an outage.
  //
  // packModified means a human has edited this since it was installed, so an upgrade must show a diff
  // Retired by a pack uninstall, NOT deleted.
  //
  // A document type with documents captured under it cannot be removed — the documents would lose the
  // definition of their own fields, which is the orphaning this codebase has already been bitten by.
  // So uninstall retires what real records depend on: gone from every picker, still readable, so a
  // two-year-old Iqama still renders with its fields intact.
  retired       Boolean        @default(false)
  // rather than overwrite. Null packKey = made here, owned by you, never touched by a pack.
  packKey       String?
  packVersion   String?
  packModified  Boolean        @default(false)
  // Which country this belongs to. Configuration was implicitly Saudi everywhere; with a second
  // country pack installed, an unmarked row appears in every client's pickers regardless of the
  // market they operate in. Nullable for existing rows, backfilled to SA, defaulted on create.
  country       String?
  name          String
  tier          String
  basePrice     Int
  billingCycle  String         @default("monthly")
  empMin        Int
  empMax        Int
  features      Json
  serviceIds    Json?          @default("[]") // catalog ServiceItem ids included in this package
  color         String?
  subscriptions Subscription[]

  @@index([packKey])
}

model Subscription {
  id            String   @id @default(cuid())
  scope         String // "group" | "company"
  refId         String // group id or company id
  package       Package  @relation(fields: [packageId], references: [id])
  packageId     String
  price         Int
  startDate     String?
  endDate       String?
  daysLeft      Int      @default(0)
  autoRenew     Boolean  @default(true)
  custom        Boolean  @default(false)
  company       Company? @relation(fields: [companyId], references: [id])
  companyId     String?
  // Billing-period marker: the endDate the last recurring invoice was raised for. The renewal job
  // refuses to invoice the same period twice, which is what stops an hourly tick from billing a
  // client 24 times a day.
  lastBilledFor String?
  lastRenewedAt String?
  // Per-client service add-ons: [{ serviceId, name, price, addedAt, by, invoiceId }].
  // Deliberately HERE and not on Package.serviceIds — a package is shared by every client on that
  // tier, so unlocking a service there would hand it to all of them. This is the one rule this
  // feature turns on: entitlement = the package's services ∪ this subscription's add-ons.
  addons        Json?    @default("[]")

  @@index([refId, scope])
}

model Employee {
  id             String  @id @default(cuid())
  company        Company @relation(fields: [companyId], references: [id])
  companyId      String
  name           String
  // WHAT MAKES THIS PERSON THIS PERSON.
  //
  // The row carried nothing unique but the name, so two employees called Mohammed Ali were
  // indistinguishable — to a picker, to a report, and to every piece of code that matched a document
  // to a person by name. `code` is the handle a human quotes; `govId` is the number the government
  // knows them by. Both optional because rows exist that predate them and a blank code must not stop
  // anyone working.
  //
  // The code is unique WITHIN A CLIENT, not across the firm — see @@unique below. Each client numbers
  // its own staff from 1, so two clients both having an EMP-0002 is normal and must not be blocked.
  // An invoice number is the opposite case and stays firm-wide unique.
  code           String?
  govId          String? // Iqama / national ID / passport no. — whatever identifies them officially
  // Facts a PREREQUISITE can test. A rule could only ever say "another document, valid N months",
  // because there was nothing else on the row to compare against — a minimum-age rule needs a date.
  //
  // Nationality previously lived in `customData["cf-nat"]`, a Form Builder field. It is a column now
  // and that field was retired from the employee form: two places to type the same fact means the rule
  // reads one while the user fills the other, and the check silently passes on an empty value.
  dob            String? // ISO date. Age is derived, never stored — a stored age is wrong within a year.
  // ISO 3166-1 alpha-2, NOT free text. It was a text box with the placeholder "e.g. Saudi", which
  // invites "Saudi", "Saudi Arabian", "KSA" and "saudi" as four different countries. A nationality
  // that four spellings can hide behind is fine as a label and useless as something to count, and a
  // workforce quota that misses a spelling under-reports — the dangerous direction. Comparisons go
  // through resolveCountry(), so a rule written as "Saudi" still matches a row stored as "SA".
  nationality    String?
  // Which country's workforce this person counts toward. Usually the employer's, but a group with
  // entities in two countries needs to say which one — an employee counts once, not everywhere.
  workCountry    String?
  // Facts a workforce-quota calculation needs and the row did not carry. All nullable: a percentage
  // computed from incomplete data must report how much it could see rather than quietly assume.
  salary         Int? // monthly, in minor units — see money.ts for why money is never a float
  employmentType String? // full_time | part_time — part-time counts fractionally in some regimes
  jobCategory    String? // skilled | unskilled | … — some regimes count only part of the workforce
  role           String?
  iqamaExpiry    String?
  status         String  @default("valid")
  customData     Json? // values for admin-defined custom employee fields (Form Builder / CustomObject)
  archived       Boolean @default(false)
  history        Json? // append-only audit: [{ at, event, detail, by }] — e.g. workflow approved/rejected
  // Offboarding. `archived` stays the FINAL state (every headcount already filters on it); these track
  // the run-up to it. The moment this leaves "active" the renewal engine stops touching their
  // documents — renewing the visa of someone who is leaving is the bug this exists to prevent.
  exitStatus     String  @default("active") // active | exit_requested | exiting | exited
  exitDate       String? // last working day, as declared by the client
  exitReason     String? // resignation | termination | end_of_contract | transfer | other
  exitRequestId  String? // the ServiceRequest that tracks the exit

  // Per client, not per system: each client numbers its own staff, so EMP-0002 may exist at several
  // clients at once. Still a real constraint — one client cannot issue the same code twice.
  @@unique([companyId, code])
  @@index([companyId, archived])
  @@index([exitStatus])
}

model Document {
  id               String  @id @default(cuid())
  company          Company @relation(fields: [companyId], references: [id])
  companyId        String
  person           String // display label of the subject (employee name OR company name)
  employeeId       String? // real link when subjectKind = "employee"; null for company-scoped docs
  docType          String
  expiryDate       String?
  status           String  @default("valid")
  daysLeft         Int     @default(0)
  customData       Json? // values for the document type's dynamic fields, keyed by field id
  // Renewal-in-flight pointers, set by the expiry trigger (scheduler). Their real job is IDEMPOTENCY:
  // the trigger runs hourly, so without these it would file a fresh renewal every hour. Cleared when
  // the renewal finishes/cancels, which re-arms the document for a future cycle.
  renewalRunId     String? // WorkflowInstance renewing this doc
  renewalTaskId    String? // plain Task renewing it (when no workflow is bound to the docType)
  docNumber        String? // standard fields (all types)
  issueDate        String?
  issuingAuthority String?
  history          Json? // renewal versions: [{ at, by, oldExpiry, newExpiry, oldNumber, newNumber, fee, receipt, note }]
  // ONE LIVE DOCUMENT PER TYPE PER SUBJECT.
  //
  // A person could hold two passports with different numbers and expiries, and nothing decided which
  // one counted: the prerequisite check, the renewal trigger and the compliance score each ran
  // findFirst and got whichever the database returned first. So the same passport could satisfy a
  // requirement on one screen and fail it on another.
  //
  // Superseded rows are KEPT — the old number and expiry are the audit trail — but every reader
  // filters them out, so exactly one document of a type is authoritative for a subject at a time.
  supersededAt     String? // ISO; null = this is the live one
  supersededById   String? // the document that replaced it, when there is one

  @@index([supersededAt])
  @@index([status])
  @@index([expiryDate])
  @@index([companyId, status])
  @@index([employeeId])
}

// Admin-defined document types with their own dynamic fields + renewal config (no-code).
model DocumentType {
  id                  String  @id @default(cuid())
  // Provenance, for rows that came from a country pack.
  //
  // packKey is the stable identity a pack uses — sa.doctype.iqama — so a re-install recognises this
  // row instead of creating a second one, and an upgrade can find what it is upgrading. Deliberately
  // INDEXED rather than @unique: a unique constraint is the change Prisma refuses without
  // --accept-data-loss, which crash-looped the live API earlier today. The installer enforces
  // uniqueness itself, and pays for that with a check rather than an outage.
  //
  // packModified means a human has edited this since it was installed, so an upgrade must show a diff
  // Retired by a pack uninstall, NOT deleted.
  //
  // A document type with documents captured under it cannot be removed — the documents would lose the
  // definition of their own fields, which is the orphaning this codebase has already been bitten by.
  // So uninstall retires what real records depend on: gone from every picker, still readable, so a
  // two-year-old Iqama still renders with its fields intact.
  retired             Boolean @default(false)
  // rather than overwrite. Null packKey = made here, owned by you, never touched by a pack.
  packKey             String?
  packVersion         String?
  packModified        Boolean @default(false)
  // Which country this belongs to. Configuration was implicitly Saudi everywhere; with a second
  // country pack installed, an unmarked row appears in every client's pickers regardless of the
  // market they operate in. Nullable for existing rows, backfilled to SA, defaulted on create.
  country             String?
  name                String  @unique
  fields              Json?   @default("[]") // array of { id, label, type, options?, required? }
  prereqs             Json?   @default("[]") // renewal rules: array of { requiresDocType, minMonths }
  leadDays            Int? // reminder lead time — days before expiry the doc flags "expiring" (default 30)
  defaultFee          Int? // default renewal fee (SAR)
  requiresApproval    Boolean @default(false)
  defaultAssigneeRole String? // role a renewal task defaults to
  authority           String? // issuing authority (GDRFA, MOHRE, Qiwa…) shown on the type + its docs
  subjectKind         String  @default("employee") // who the doc belongs to: "employee" (Iqama, visa…) | "company" (CR, GOSI, VAT…)

  @@index([packKey])
}

// Admin-defined custom object/record type (Object Builder) or standalone form (Form Builder), distinguished by `kind`.
model CustomObject {
  id        String  @id @default(cuid())
  name      String
  icon      String? // optional emoji
  fields    Json?   @default("[]") // array of { id, label, type, options?, required? }
  // Only "form" is used. The Object Builder — a no-code record designer whose records had nowhere
  // to be seen outside the builder itself — was removed; this is the Form Builder's storage now.
  kind      String  @default("form")
  appliesTo String  @default("") // form-only: "" standalone | "employee" | "client" → fields feed that record's Add form
}

model Task {
  id                 String   @id @default(cuid())
  title              String
  company            Company? @relation(fields: [companyId], references: [id])
  companyId          String?
  clientName         String?
  assigneeId         String? // the user; `assignee` below is the display mirror. See WorkflowTask.
  assignee           String?
  priority           String   @default("medium")
  dueDate            String?
  status             String   @default("todo")
  docType            String?
  // Government authority this task is submitted to (Qiwa, Muqeem…). The Government Centers screen
  // buckets its queues by this — it was read there but never written by any form until now.
  govCenter          String?
  archived           Boolean  @default(false) // soft-archive; recoverable via the Archived view
  workflowInstanceId String? // set when creating this task also launched a workflow run
  complianceDocId    String? // renewal task → the compliance document it renews (cross-link)
  // The quotation whose acceptance created this task. Also the idempotency key: delivery is started
  // once per quotation, and "has this quotation any tasks?" is the check that stops a second run.
  quotationId        String?
  // The client request whose acceptance created this task. Same role as quotationId above: the
  // provenance of the work, and the idempotency key that stops a request being accepted twice.
  requestId          String?
  employeeId         String? // subject when the task/workflow concerns a specific employee (person docs)
  customData         Json? // values for admin-defined custom task fields (Form Builder → Applies to: Task)
  // Two-phase prerequisite gating: when set, this (Phase-2) task is PARKED waiting on prerequisite
  // workflow run(s). { runIds:[...], resumeWorkflowId?, autoResume, reason }. Cleared when it resumes.
  blockedBy          Json?
  // Human-facing reference (TSK-0001) from the configured record sequence. A task was identified
  // only by its cuid, which nobody can read out over a phone.
  ref                String?

  @@index([status])
  @@index([assignee])
  @@index([companyId, archived])
  @@index([govCenter])
  @@index([quotationId])
  @@index([requestId])
}

model Invoice {
  id             String   @id @default(cuid())
  number         String
  company        Company? @relation(fields: [companyId], references: [id])
  companyId      String?
  clientName     String?
  // Whole currency units. DERIVED from totalMinor on every write and kept because reports, the dunning
  // job, the invoice list and the portal all read it — changing its meaning would touch every one of
  // them. `*Minor` below is what the DOCUMENT says; this is a convenience with a single writer.
  amount         Int
  // WHAT THE INVOICE SAYS, FROZEN AT ISSUE.
  //
  // These were computed on the fly at print time instead: the stored total was treated as VAT-inclusive
  // and divided back out. Two consequences, both wrong on a tax document —
  //   · VAT was rounded to whole riyals on save, so re-dividing could not return the original figure:
  //     lines of SAR 250 at 15% saved as 288, then printed a subtotal of SAR 250.43.
  //   · No rate was stored, so changing the Print Layout VAT rate reprinted every past invoice with
  //     different numbers — including the figures inside its ZATCA QR.
  //
  // Minor units (halala) because SAR carries two decimals and `amount Int` could not hold them, which
  // is where the rounding came from in the first place. Integer arithmetic throughout: exact, no floats.
  subtotalMinor  Int? // 25000 = SAR 250.00
  vatMinor       Int?
  totalMinor     Int?
  vatRateBp      Int? // basis points: 1500 = 15.00%. Frozen at issue, never re-read from settings.
  currency       String   @default("SAR")
  status         String   @default("pending")
  date           String?
  dueDate        String?
  services       String?  @db.Text
  // Line items: [{ name, units, price }]. `amount` stays the source of truth for totals/reports and
  // is recomputed from these on save, so existing single-amount invoices keep working untouched.
  items          Json?    @default("[]")
  notes          String?  @db.Text
  // Payment extension / promise-to-pay. While `promisedDate` is in the future the dunning job stops
  // chasing this invoice and it stops counting toward a suspension recommendation — an arrangement
  // the client has actually agreed should not keep generating reminders.
  promisedDate   String?
  promisedNote   String?
  // Set when this invoice was raised from an accepted quotation, so the two are linked instead of
  // the quote being retyped by hand with nothing tying them together.
  quotationId    String?
  // Set when the invoice was raised for a plan add-on, so voiding it knows which add-on it paid
  // for. Without it a void is just an accounting event and the service silently stays free.
  addonServiceId String?
  // Voiding. An issued invoice is never deleted — it stays on file with status "void" and a reason,
  // because a tax document that vanishes is worse than one marked cancelled.
  voidedAt       String?
  voidReason     String?

  @@index([status])
  @@index([date])
  @@index([promisedDate])
}

model User {
  id                 String  @id @default(cuid())
  name               String
  email              String  @unique
  passwordHash       String?
  roleId             String  @default("admin")
  status             String  @default("active")
  lastActive         String?
  type               String  @default("staff") // staff | portal
  // `managerId` was here: a pointer on each person saying who they reported to, with the team left
  // to be inferred from everyone sharing a value. The argument for it was that one column cannot
  // drift. What it could not do is the thing this firm actually needs — CHANGE A LEAD. That was one
  // edit per member with nothing to tell you which one you missed, and afterwards there was no
  // record that the old lead had ever led anything, so a report about last quarter was computed
  // against this quarter's team. It was set on 0 of 7 staff when it was removed, so nothing was
  // migrated. See model Team.
  companyId          String? // for portal users
  phone              String?
  // `assignedClientIds` was here: a JSON array of the client ids a sales user was allowed to see.
  // It is gone. Ownership is a fact about the CLIENT, so it lives on the client as `Company.ownerId`
  // — a column that can be joined, sorted, grouped and reported on, and that cannot hold the same
  // client twice under two different people. See scripts/migrate-ownership.ts.
  mustChangePassword Boolean @default(false) // portal users must set their own password on first login
  tokenVersion       Int     @default(0) // bump to invalidate all previously issued JWTs
  failedLogins       Int     @default(0) // consecutive failed logins → lockout
  lockedUntil        String? // ISO timestamp; login refused until then
  resetTokenHash     String? // sha256 of the password-reset token
  resetExpires       String? // ISO timestamp the reset token expires
  // Portal notifications are DERIVED from documents/requests/invoices, not stored rows, so there is
  // nothing to flag individually. "Mark all read" records a watermark instead: anything older than
  // this is read. Without it the control could only ever be local state that reset on reload.
  notifReadAt        String?
}

/// A TEAM, AND WHO LED IT WHEN.
///
/// WHY THIS IS A TABLE AND NOT A COLUMN. It replaced `User.managerId`, whose comment argued that a
/// single column cannot drift out of step with reality. True, and beside the point: the operation
/// this firm performs on a team is CHANGING ITS LEAD, and a pointer-per-person made that one edit
/// per member with no way to confirm you had caught them all. It also could not answer "who led
/// this team in September", so every historical number was silently computed against today's team.
///
/// A lead is still NOT a role. Roles answer "what may you do"; a team answers "whose work may you
/// see, and hand out". The permissions matrix is untouched by any of this.
///
/// Per the firm's working model a lead OVERSEES and does not carry clients — which is precisely why
/// changing one is safe and cheap: no ownership, no deal and no task moves. Only who can see.
model Team {
  id        String       @id @default(cuid())
  name      String
  /// sales | pro — which side of the business. Set on the TEAM, never inferred from its members'
  /// roles: a PRO team that happens to contain an accountant is still a PRO team.
  kind      String
  country   String?
  active    Boolean      @default(true)
  createdAt String
  members   TeamMember[]
  leads     TeamLead[]

  @@index([kind, active])
}

/// Who was in a team, and WHEN — append-only.
///
/// A person leaving stamps `toDay`; the row is never deleted and never edited to point somewhere
/// else. That is the whole reason this table exists rather than a `User.teamId` column: a deleted
/// or overwritten row cannot answer a question about last quarter, and answering questions about
/// last quarter is what the history is for.
///
/// There is deliberately NO denormalised pointer on User. The current team is the row with no
/// `toDay`, derived on read. A cached copy would be a second source of truth whose only job is to
/// agree with this one, and the interesting bugs all live in the moment it stops agreeing.
model TeamMember {
  id      String  @id @default(cuid())
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId  String
  userId  String
  /// ISO day, inclusive.
  fromDay String
  /// ISO day the person left, exclusive. Null = still a member. Named `fromDay`/`toDay` rather than
  /// from/to because FROM is a reserved word in MySQL and a quoted column name is a trap for the
  /// next person writing raw SQL against this.
  toDay   String?

  @@index([teamId, toDay])
  @@index([userId, toDay])
}

/// Who led a team, and WHEN.
///
/// Separate from membership on purpose. A lead change and a member change are different events with
/// different consequences, and folding them into one table means every query begins by asking which
/// kind of row it is looking at — which is how "the lead" and "a member who was once the lead" end
/// up counted as the same thing.
///
/// A lead need not be a member of the team they lead, and may be a member of another one; that is
/// how a second tier is expressed without anything recursive. Visibility still resolves ONE level.
model TeamLead {
  id      String  @id @default(cuid())
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId  String
  userId  String
  fromDay String
  toDay   String?

  @@index([teamId, toDay])
  @@index([userId, toDay])
}

model Audit {
  id         String  @id @default(cuid())
  action     String // e.g. login.success, password.change, credential.reveal
  actorId    String?
  actorEmail String?
  target     String? // what was acted on
  detail     String? @db.Text
  ip         String?
  at         String // ISO timestamp

  @@index([at])
  @@index([actorId])
  @@index([action])
}

model UpgradeRequest {
  id            String  @id @default(cuid())
  company       Company @relation(fields: [companyId], references: [id])
  companyId     String
  clientName    String
  fromPackageId String?
  toPackageId   String?
  note          String? @db.Text
  status        String  @default("pending")
  date          String?
  // "package" = move the client to another tier (the original flow).
  // "addon"   = unlock ONE service on top of the tier they already have. Same review queue, so staff
  //             see both kinds in one place instead of a second inbox.
  kind          String  @default("package")
  serviceId     String? // addon only — the ServiceItem being requested
  serviceName   String? // snapshot, so the queue still reads correctly if the catalog item is renamed
  quotedPrice   Int? // addon only — set by staff at approval; the client never sees a price before that

  @@index([status])
  @@index([kind])
}

model SiteCredential {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id])
  companyId String
  label     String
  url       String
  username  String?
  password  String // NOTE: encrypt at rest in production
  notes     String? @db.Text
  // Which government portal this login is for, so a step that names an authority can point straight
  // at the right credential instead of leaving the officer to search the vault by client and guess
  // from the label. DECLARED, not inferred: matching "Qiwa" against a free-text label is the same
  // guess-presented-as-fact that had the Services list showing workflows it would never run.
  govCenter String?

  @@index([govCenter])
}

model Activity {
  id      String  @id @default(cuid())
  type    String
  message String? @db.Text
  user    String?
  time    String?
  date    String?

  @@index([date])
}

model ServiceRequest {
  id                 String  @id @default(cuid())
  // Reference (REQ-0001) from the configured record sequence. Both apps used to display
  // "SRV-" + the last four characters of the cuid — a label derived from a database id, which
  // nobody can quote back and which is not unique in any meaningful sense.
  number             String?
  companyId          String?
  clientName         String?
  type               String?
  message            String? @db.Text // the client's opening message; the thread lives in ServiceRequestMessage
  // open | accepted | resolved | rejected — a client reply reopens it.
  //
  // `accepted` exists because "approve" used to write "resolved": the vocabulary said the work was
  // FINISHED at the moment it was agreed, and there was no state for the part in between, which is
  // where a request spends nearly all of its life.
  status             String  @default("open")
  date               String?
  // What accepting this request produced. Null while open; both set together when work starts, and
  // workflowInstanceId stays null when the service has no template bound (ten of fourteen today).
  taskId             String?
  workflowInstanceId String?
  serviceItemId      String? // the catalogue service that was agreed — may differ from the typed `type`
  acceptedAt         String?
  rejectedReason     String? // shown to the client; rejecting used to say nothing at all
  // Unread is derived from these rather than a per-user read table — two timestamps per side is
  // enough at this scale and keeps the bell query trivial.
  lastClientMsgAt    String?
  lastStaffMsgAt     String?
  staffReadAt        String?
  clientReadAt       String?

  @@index([companyId])
  @@index([status])
}

// One message in a request's thread. `internal` notes are staff-only and are filtered out of every
// portal response — that filtering is the whole point, so it lives server-side, never in the client.
// A file the client attached to a request, against the document it is meant to be.
//
// The attachment used to be a LINE OF TEXT: the uploader glued "Attachment: http://…/files/x.pdf"
// onto the end of the request message. So nothing knew which document a file was, several files
// could not be told apart, and the workflow's collect step could not tick anything off — the officer
// asked the client again for papers already sitting in the request.
//
// `docKey` matches a key in ServiceItem.requiredDocs; "other" holds the extras the client adds.
model RequestAttachment {
  id        String  @id @default(cuid())
  requestId String
  docKey    String  @default("other")
  label     String?
  path      String // /files/<name>
  name      String? // the client's own filename, for display
  size      Int     @default(0)
  at        String?

  @@index([requestId])
}

model ServiceRequestMessage {
  id         String  @id @default(cuid())
  requestId  String
  authorType String  @default("staff") // "staff" | "client"
  authorName String?
  body       String  @db.Text
  internal   Boolean @default(false)
  at         String?

  @@index([requestId])
}

model Notification {
  id        String  @id @default(cuid())
  type      String
  title     String
  message   String? @db.Text
  time      String?
  // Real ISO timestamp. `time` is only a display string (everything said "Just now" forever) and the
  // id is a cuid, so there was nothing to compare a per-user read watermark against. Nullable because
  // rows written before this existed have no honest value — those are treated as already read.
  createdAt String?
  read      Boolean @default(false)
  // Set by automated jobs so a repeating tick can't repeat a notification. Unique — the insert is the
  // dedupe (no read-then-write race). Null for human-generated notifications, which may legitimately repeat.
  dedupeKey String? @unique

  @@index([read])
}

// ── BPM Workflow engine ──────────────────────────────────────────────
// A reusable process definition. The DAG lives in `graph` as { nodes:[], edges:[] }.
// node  = { id, type, label, config }   type: start|task|approval|decision|parallel_split|parallel_join|notify|webhook|delay|end
// edge  = { id, from, to, label?, condition? }   condition routes decision/approval outcomes (e.g. "approve","reject","<branchKey>","else")
model WorkflowTemplate {
  id            String             @id @default(cuid())
  // Provenance, for rows that came from a country pack.
  //
  // packKey is the stable identity a pack uses — sa.doctype.iqama — so a re-install recognises this
  // row instead of creating a second one, and an upgrade can find what it is upgrading. Deliberately
  // INDEXED rather than @unique: a unique constraint is the change Prisma refuses without
  // --accept-data-loss, which crash-looped the live API earlier today. The installer enforces
  // uniqueness itself, and pays for that with a check rather than an outage.
  //
  // packModified means a human has edited this since it was installed, so an upgrade must show a diff
  // Retired by a pack uninstall, NOT deleted.
  //
  // A document type with documents captured under it cannot be removed — the documents would lose the
  // definition of their own fields, which is the orphaning this codebase has already been bitten by.
  // So uninstall retires what real records depend on: gone from every picker, still readable, so a
  // two-year-old Iqama still renders with its fields intact.
  retired       Boolean            @default(false)
  // rather than overwrite. Null packKey = made here, owned by you, never touched by a pack.
  packKey       String?
  packVersion   String?
  packModified  Boolean            @default(false)
  // Which country this belongs to. Configuration was implicitly Saudi everywhere; with a second
  // country pack installed, an unmarked row appears in every client's pickers regardless of the
  // market they operate in. Nullable for existing rows, backfilled to SA, defaulted on create.
  country       String?
  name          String
  description   String?            @db.Text
  trigger       String             @default("manual") // manual | document_expiry | request_intake
  triggerConfig Json? // { docType, days } etc.
  entityType    String             @default("generic") // visa | company_formation | ...
  graph         Json               @default("{\"nodes\":[],\"edges\":[]}")
  version       Int                @default(1)
  active        Boolean            @default(false)
  createdAt     String?
  instances     WorkflowInstance[]

  @@index([packKey])
}

// A running (or finished) execution of a template over one subject (a visa request, a client, etc.).
model WorkflowInstance {
  id          String           @id @default(cuid())
  template    WorkflowTemplate @relation(fields: [templateId], references: [id])
  templateId  String
  title       String
  companyId   String?
  clientName  String?
  variables   Json?            @default("{}") // process variables (country, visaType, passportValid, …) incl. engine bookkeeping keys prefixed with _
  status      String           @default("running") // running | completed | cancelled | failed
  startedAt   String?
  completedAt String?
  tasks       WorkflowTask[]
  logs        WorkflowLog[]

  @@index([companyId])
  @@index([status])
}

// A unit of human work produced by a task/approval node. The engine waits on these.
model WorkflowTask {
  id                  String           @id @default(cuid())
  instance            WorkflowInstance @relation(fields: [instanceId], references: [id])
  instanceId          String
  nodeId              String // originating graph node
  nodeType            String           @default("task") // task | approval
  title               String
  // WHO, as an id — not just a name.
  //
  // `assignee` is a display name and used to be the only record of who a step belonged to, so nothing
  // could turn a task into a mailbox: two people called Ahmed are one string, and a rename orphans
  // the row silently. The id is the fact; the name beside it is a mirror kept for display and for the
  // load-balancing group-by. Same lesson as resolving documents by employeeId rather than by person.
  assigneeId          String?
  assignee            String? // display mirror of assigneeId — see above
  assigneeRole        String? // role gate — who may complete it
  status              String           @default("active") // active | done | approved | rejected | skipped
  priority            String           @default("medium")
  dueDate             String?
  slaHours            Int?
  // What the person doing this step is supposed to do. SNAPSHOTTED from the node when the step is
  // created, for the same reason the checklist is: editing the template must not rewrite the
  // instructions someone is already working from. There was no field for this at all, so
  // "Verify passport validity" was the entire brief a new officer got.
  instructions        String?          @db.Text
  // A document this step must SEE and CHECK before it can be completed: { docType, minMonths }.
  // Snapshotted at creation like the checklist and the instructions, so editing the template cannot
  // change the rule someone is already being held to. Steps could collect a document type's fields
  // and write them back, but could never look at an existing document and refuse — so "verify the
  // passport has six months left" was a label, not a control.
  verifyRule          Json?
  checklist           Json? // resolved item defs snapshot: [{ key, label, required }] (also accepts legacy [{label,done}])
  checklistState      Json? // per-item runtime state: { [key]: { received, verified, note?, fileRef? } }
  requireVerification Boolean          @default(false) // completion needs each required item received AND verified
  captures            Json? // [{ var, label, type, options? }] — variables the completer must set
  outcome             String? // approval: approve|reject ; task with branches: chosen key
  completedBy         String?
  completedAt         String?
  createdAt           String? // when the step became active — for SLA elapsed calc
  // SLA escalation bookkeeping. `slaState` is the last state the escalator ACTED on, so it only fires
  // on a real transition (on_track→at_risk→breached) instead of re-notifying every hourly tick.
  slaState            String? // null (never evaluated) | on_track | at_risk | breached
  escalatedAt         String?
  // Which authority this step is carried out at, snapshotted from the node like the instructions.
  // The portal used to live only on the parent Task — one value per case — so a cancellation that
  // runs through Qiwa, Muqeem and GOSI could name just one of them, and the Government Centers queue
  // could only ever list whole cases rather than the jobs waiting at each authority.
  govCenter           String?

  @@index([status])
  @@index([assigneeRole])
  @@index([govCenter])
}

// Admin-defined rule that maps instance variables → a document set (dynamic per-client checklists).
// rows: [{ conditions: [{ var, op, value }], documents: [{ key, label, required }] }] — union of matching rows.
/// What one client's workforce looked like on one day.
///
/// WHY THIS EXISTS
///
/// The ratio could always be counted for today, and drift could be measured against the moment
/// somebody wrote a band down. Neither answers "is this getting better or worse", because nothing
/// was ever kept. History cannot be reconstructed later — an employee record does not say when it
/// was added, and one that has been deleted says nothing at all — so a day not captured is a day
/// gone for good. That is the whole argument for the table.
///
/// WHY THE DERIVED FIGURES ARE STORED, NOT RECOMPUTED
///
/// Everywhere else in this codebase a figure that can be computed is computed, because a stored copy
/// goes stale. A snapshot is the exact opposite case: it must keep saying what was TRUE THAT DAY.
/// Recomputing `bandName` from today's thresholds would silently rewrite last year's record the
/// first time a regulator moved a boundary, and the trend would then show a change that never
/// happened. The counts are kept alongside so a reader can always see what the ratio was made of.
model WorkforceSnapshot {
  id         String  @id @default(cuid())
  companyId  String
  country    String?
  /// The DAY, as YYYY-MM-DD. One row per client per day: the tick runs hourly and this is what
  /// stops it writing twenty-four near-identical rows.
  day        String
  /// The counts the figures below came from.
  total      Int
  nationals  Int
  expats     Int
  unknown    Int
  partTime   Int     @default(0)
  /// Basis points, the same as everywhere else. `min` assumes every unrecorded nationality is an
  /// expat; `max` assumes none is. They are equal when `certain`.
  ratioMinBp Int
  ratioMaxBp Int
  certain    Boolean @default(true)
  /// The band the thresholds gave THAT DAY, by name. Null where the country had no bands set up or
  /// the client had nobody on the books — both are real states and neither is a zero.
  bandName   String?
  createdAt  String?

  @@unique([companyId, day])
  @@index([companyId])
  @@index([day])
}

/// A nationalisation band for one country — Nitaqat's Platinum/Green/Yellow/Red, Emiratisation's
/// equivalents, whatever a market calls them.
///
/// These are CONFIGURATION, not code. They were four names hard-coded in the console, which meant the
/// band could only ever be a fact somebody read off a government portal and typed in — the app had no
/// way to work it out, and a second country could not have different bands at all.
///
/// With the thresholds recorded here the ratio decides the band directly. The thresholds are the
/// firm's own data: whoever enters them is asserting what the regulator publishes, which is a very
/// different thing from this codebase guessing at them.
///
/// Carries the same provenance columns as every other config model so a band set travels in a country
/// pack and can be upgraded, retired and uninstalled like anything else.
model WorkforceBand {
  id           String  @id @default(cuid())
  country      String?
  name         String
  /// Text and background, so a band reads the same everywhere it appears.
  color        String?
  bg           String?
  /// Inclusive floor and exclusive ceiling, in BASIS POINTS — 3333 = 33.33%. Integers for the same
  /// reason money is: a percentage held as a float puts a client on the wrong side of a boundary.
  /// `maxBp` null means "and above", so the top band needs no invented upper limit.
  minBp        Int
  maxBp        Int?
  /// Lowest first. Two bands that overlap are a configuration error the editor refuses to save.
  sort         Int     @default(0)
  retired      Boolean @default(false)
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)

  @@index([packKey])
  @@index([country])
}

/// One column of the sales pipeline, for one country.
///
/// Configuration, like workforce bands and for the same reason: a firm's sales process is its own,
/// and the stages a Saudi PRO practice runs ("Enquiry → Quoted → Documents in → Won") are not the
/// ones its Emirati branch would use. Hard-coding a set here would make the board a picture of how
/// somebody else sells.
///
/// Carries the same provenance columns as every other config model, so a stage set travels in a
/// country pack and can be upgraded, retired and uninstalled like anything else.
model PipelineStage {
  id             String        @id @default(cuid())
  country        String?
  name           String
  color          String?
  bg             String?
  /// Left to right. Two stages with the same sort are a configuration error the editor refuses.
  sort           Int           @default(0)
  /// The odds a deal in this column closes, in basis points — 2500 = 25%. Used for the weighted
  /// total at the top of each column, so "SAR 400,000 in the pipeline" can be read as what it is
  /// rather than as money anybody expects to bank.
  probabilityBp  Int           @default(0)
  /// The two terminal columns. An opportunity's status is DERIVED from these — see Opportunity.
  /// Exactly one of each per country; the editor enforces it, because a pipeline with no won column
  /// can never record a sale and one with two has no single answer to "did we win it".
  isWon          Boolean       @default(false)
  isLost         Boolean       @default(false)
  /// HOW LONG A DEAL MAY SIT IN THIS COLUMN before it is called stalled. Null falls back to the
  /// global `staleDealDays` setting.
  ///
  /// Separate from `followUpDays` below, which is a nudge — "chase them on Thursday". This is a
  /// limit: past it, the deal is reported as stalled on the dashboard and in the hourly notice.
  /// Per-stage because the tolerances genuinely differ — a fortnight in Enquiry is normal and a
  /// fortnight in Contract Signing is a problem.
  ///
  /// This column exists because "stalled" had drifted into meaning two different things: the hourly
  /// job measured days since anybody last SPOKE to the client, the dashboard measured days the card
  /// had sat in one COLUMN, and neither said which it meant. Both measures are useful; having two
  /// unlabelled ones was the bug. See src/dealhealth.ts, which is now the only place either is
  /// worked out.
  maxDays        Int?
  /// How many days after landing here somebody should chase, or null for "no rule".
  ///
  /// The stale-deal nudge already catches a deal nobody has touched for a fortnight, but that is a
  /// backstop, not a plan: a quotation sent on Monday wants chasing on Thursday, not in two weeks.
  /// A window per stage is the difference between the pipeline reminding people and the pipeline
  /// merely recording what they remembered.
  followUpDays   Int?
  /// What the chase actually IS, in the words the owner will read on their queue. "Follow up" tells
  /// nobody anything; "Chase for a decision on the quotation" is a task. Falls back to a sentence
  /// naming the stage when left empty.
  followUpAction String?
  /// WHAT A DEAL MUST SATISFY TO LEAVE THIS STAGE.
  ///
  /// "dynamic" resolves `checklistRuleId` against facts the deal already holds — its source, its
  /// size, its country, whether a quotation exists — using the same ChecklistRule engine the
  /// workflow steps use. "static" uses the list typed on the stage below. Null means no checklist,
  /// which is the state every stage starts in and a perfectly good answer for most of them.
  ///
  /// Reusing ChecklistRule rather than inventing a second one is deliberate: it is already
  /// country-scoped and already ships inside a country pack, so a market's sales requirements travel
  /// with its documents and workflows instead of being re-typed per installation.
  checklistSource String?
  checklistRuleId String?
  /// The static list: [{ key, label, required, source: "manual" | "document", docType? }].
  /// A `document` item is never ticked by a person — it is satisfied when a live Document of that
  /// type exists for the deal's company, so the list reads as a status rather than a second to-do.
  checklistItems  Json?
  retired        Boolean       @default(false)
  packKey        String?
  packVersion    String?
  packModified   Boolean       @default(false)
  opportunities  Opportunity[]

  @@index([packKey])
  @@index([country])
}

/// Where business comes from, and why it is lost — per country.
///
/// WHY THESE EXIST AT ALL
///
/// Both fields were free text, and free text does not group. "Price", "price", "too expensive" and
/// "cost" are one reason typed four ways, and the loss report — the single most useful thing a sales
/// screen can show — silently splits them into four rows of one, which reads as "no clear pattern"
/// when the pattern is the whole story.
///
/// WHY THEY ARE A SUGGESTION AND NOT A RULE
///
/// The server does NOT validate against these lists, deliberately. Every value recorded before they
/// existed would fail, and a country nobody has configured a list for could not record a loss at
/// all — which would mean the rule "say why it was lost" could not be satisfied. The list makes the
/// common answers one press and consistent; anything genuinely new is still typeable.
///
/// Two tables rather than one picklist with a `kind` column: the pack machinery maps one key to one
/// model, and a shared table would put sources and loss reasons in the same pack section.
model LeadSource {
  id           String  @id @default(cuid())
  country      String?
  name         String
  color        String?
  bg           String?
  sort         Int     @default(0)
  retired      Boolean @default(false)
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)

  @@index([packKey])
  @@index([country])
}

/// WHERE A DEAL HAS BEEN — one row per stage move, appended forever.
///
/// The Opportunity stores only its CURRENT stage and when it arrived there, which answers "how long
/// has it sat here" and nothing else. This table answers the questions that cannot be reconstructed
/// later: how long deals normally spend in each stage, which stage they die in, who moved what. It
/// is append-only and exists BEFORE the history matters, because by the time it matters it is too
/// late to start.
///
/// `durationDays` is deliberately absent — it is the gap between consecutive rows, derived on read.
/// `isBackward` is deliberately PRESENT, the opposite call: it is judged against stage sort order AT
/// THE MOMENT of the move, and sorts get edited and stages retired, so it genuinely cannot be
/// reconstructed afterwards.
model StageTransition {
  id            String  @id @default(cuid())
  opportunityId String
  /// Null = the deal ARRIVED here at creation — its first stage, not a move.
  fromStageId   String?
  toStageId     String
  /// Who moved it, or null for the system (renewal job, quotation acceptance, add-on approval).
  movedById     String?
  movedAt       String
  /// Captured when the move WAS the loss, so "died in Quoted because Price" is one row.
  lostReason    String?
  isBackward    Boolean @default(false)

  @@index([opportunityId])
  @@index([toStageId])
  @@index([movedAt])
}

/// WHAT THE RELATIONSHIP HAS BEEN — one row per lifecycle change, appended forever.
///
/// The company stores only its CURRENT lifecycle; the Activity feed records changes as prose, which
/// can be read but not computed on. This is the structural record: it is what makes "how long does
/// a lead take to become a client" and the lead→prospect→client funnel answerable at all.
///
/// It also settles a date that had quietly become ambiguous. `Company.createdAt` means "client
/// since" per its own comment, was stamped at lead-arrival by the web intake, and was never stamped
/// at all by the staff form — three behaviours for one column. Here the arrival row (fromLifecycle
/// null) IS the lead-capture date and the →client row IS client-since, each unambiguous.
model LifecycleTransition {
  id            String  @id @default(cuid())
  companyId     String
  /// Null = the company ENTERED the system in `toLifecycle` — its first state, not a change.
  fromLifecycle String?
  toLifecycle   String
  /// Who changed it, or null for the system (web intake, booking link).
  changedById   String?
  changedAt     String
  /// Captured when the change WAS the loss — the same reason the lifecycle route already demands.
  reason        String?

  @@index([companyId])
  @@index([toLifecycle])
  @@index([changedAt])
}

/// WHO HAS OWNED THIS COMPANY — one row per ownership change, appended forever.
///
/// The third history table, and the one that answers a question people actually ask out loud:
/// "why did this lead come to me?" Ownership is decided in four places — the create route's
/// auto-assign, the details form, the bulk distribute, and the web intake's routing — and until
/// now only the current holder survived, so an automatic assignment was indistinguishable from a
/// manager's decision.
///
/// `method` says WHICH mechanism, `reason` says WHY that mechanism chose this person — the routing
/// rule's own words ("Riyadh + Website"), which nextOwnerFor already computes and used to throw
/// away. Null owner on either side is meaningful: from-null is a first assignment, to-null is a
/// manager deliberately unassigning so somebody else can claim it.
model OwnerAssignment {
  id           String  @id @default(cuid())
  companyId    String
  fromOwnerId  String?
  toOwnerId    String?
  /// Who made the change, or null when a job or a public endpoint did.
  assignedById String?
  /// auto | manual | distribute | intake
  method       String
  reason       String?
  at           String

  @@index([companyId])
  @@index([toOwnerId])
  @@index([at])
}

/// Why a follow-up was abandoned — suggest-don't-constrain, like every other list here.
model CancelReason {
  id           String  @id @default(cuid())
  country      String?
  name         String
  color        String?
  bg           String?
  sort         Int     @default(0)
  retired      Boolean @default(false)
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)

  @@index([packKey])
  @@index([country])
