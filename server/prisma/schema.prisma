// STIMES PRO — data model (mirrors the frontend built model)
generator client {
  provider      = "prisma-client-js"
  // "native" = your dev OS; the others cover common Linux shared hosts (Debian/Ubuntu, RHEL/CloudLinux)
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model ClientGroup {
  id         String    @id @default(cuid())
  name       String
  contact    String?
  email      String?
  companies  Company[]
}

model Company {
  id              String           @id @default(cuid())
  name            String
  cr              String
  industry        String?
  employees       Int              @default(0)
  status          String           @default("active")
  overdue         Int              @default(0)
  expiring        Int              @default(0)
  contact         String?
  email           String?
  phone           String?
  city            String?
  // Which country's law this client operates under. ISO 3166-1 alpha-2.
  //
  // Nothing in the product had a concept of country: every rule, document type and threshold was
  // implicitly Saudi. That is fine for one market and is the first thing in the way of a second one,
  // because there is nowhere to hang "this client is judged by UAE rules, not Saudi ones". Nullable
  // so existing rows are valid; backfilled to SA, which is what every one of them is.
  country         String?
  // Workforce nationalisation — Saudization here, Emiratisation next door, the same shape either way.
  //
  // The RATIO is computed from employee records and never stored: a stored percentage is wrong the
  // moment somebody is hired. The BAND is the opposite — it is not ours to compute. Its thresholds
  // are published per economic activity and per size bracket, so calculating one here would mean
  // inventing a table and announcing "Green" while the official portal says otherwise. It is recorded
  // instead: read on the portal, written down, dated, with the ratio AT THAT MOMENT captured beside it
  // so drift since is measurable. `workforceBandNote` says where it was read.
  workforceBand        String?
  workforceBandAt      String?
  workforceBandNote    String?
  workforceBandRatioBp Int?
  /// The last band the SYSTEM computed for this client, and when it noticed.
  ///
  /// Separate from workforceBand (what a human read on the portal): this is how a CHANGE is detected
  /// at all. Without it every tick would either re-announce the same band forever or announce nothing,
  /// and "this client dropped out of Green" — the one thing worth interrupting somebody for — could
  /// never be said.
  workforceBandSeen   String?
  workforceBandSeenAt String?
  // Billing suspension. `status` carries "suspended"; these record why and since when so the console
  // and the client's banner can both explain it rather than just showing a red badge.
  suspendedAt     String?
  suspendedReason String?
  customData      Json? // values for admin-defined custom client fields (Form Builder)
  // When this client was taken on. Deliberately nullable with NO default: existing rows genuinely
  // do not know, and stamping them all with the migration date would replace one fabrication
  // ("Client since 2024", picked from a hardcoded array by row position) with a tidier one.
  createdAt       String?
  group           ClientGroup?     @relation(fields: [groupId], references: [id])
  groupId         String?
  employeeList    Employee[]
  documents       Document[]
  credentials     SiteCredential[]
  invoices        Invoice[]
  tasks           Task[]
  subscriptions   Subscription[]
  upgradeRequests UpgradeRequest[]

  @@index([status])
}

model Package {
  id            String         @id @default(cuid())
  // Provenance, for rows that came from a country pack.
  //
  // packKey is the stable identity a pack uses — sa.doctype.iqama — so a re-install recognises this
  // row instead of creating a second one, and an upgrade can find what it is upgrading. Deliberately
  // INDEXED rather than @unique: a unique constraint is the change Prisma refuses without
  // --accept-data-loss, which crash-looped the live API earlier today. The installer enforces
  // uniqueness itself, and pays for that with a check rather than an outage.
  //
  // packModified means a human has edited this since it was installed, so an upgrade must show a diff
  // Retired by a pack uninstall, NOT deleted.
  //
  // A document type with documents captured under it cannot be removed — the documents would lose the
  // definition of their own fields, which is the orphaning this codebase has already been bitten by.
  // So uninstall retires what real records depend on: gone from every picker, still readable, so a
  // two-year-old Iqama still renders with its fields intact.
  retired      Boolean @default(false)
  // rather than overwrite. Null packKey = made here, owned by you, never touched by a pack.
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)
  // Which country this belongs to. Configuration was implicitly Saudi everywhere; with a second
  // country pack installed, an unmarked row appears in every client's pickers regardless of the
  // market they operate in. Nullable for existing rows, backfilled to SA, defaulted on create.
  country       String?
  name          String
  tier          String
  basePrice     Int
  billingCycle  String         @default("monthly")
  empMin        Int
  empMax        Int
  features      Json
  serviceIds    Json?          @default("[]") // catalog ServiceItem ids included in this package
  color         String?
  subscriptions Subscription[]

  @@index([packKey])
}

model Subscription {
  id        String   @id @default(cuid())
  scope     String // "group" | "company"
  refId     String // group id or company id
  package   Package  @relation(fields: [packageId], references: [id])
  packageId String
  price     Int
  startDate String?
  endDate   String?
  daysLeft  Int      @default(0)
  autoRenew Boolean  @default(true)
  custom    Boolean  @default(false)
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  // Billing-period marker: the endDate the last recurring invoice was raised for. The renewal job
  // refuses to invoice the same period twice, which is what stops an hourly tick from billing a
  // client 24 times a day.
  lastBilledFor String?
  lastRenewedAt String?
  // Per-client service add-ons: [{ serviceId, name, price, addedAt, by, invoiceId }].
  // Deliberately HERE and not on Package.serviceIds — a package is shared by every client on that
  // tier, so unlocking a service there would hand it to all of them. This is the one rule this
  // feature turns on: entitlement = the package's services ∪ this subscription's add-ons.
  addons Json? @default("[]")

  @@index([refId, scope])
}

model Employee {
  id          String  @id @default(cuid())
  company     Company @relation(fields: [companyId], references: [id])
  companyId   String
  name        String
  // WHAT MAKES THIS PERSON THIS PERSON.
  //
  // The row carried nothing unique but the name, so two employees called Mohammed Ali were
  // indistinguishable — to a picker, to a report, and to every piece of code that matched a document
  // to a person by name. `code` is the handle a human quotes; `govId` is the number the government
  // knows them by. Both optional because rows exist that predate them and a blank code must not stop
  // anyone working.
  //
  // The code is unique WITHIN A CLIENT, not across the firm — see @@unique below. Each client numbers
  // its own staff from 1, so two clients both having an EMP-0002 is normal and must not be blocked.
  // An invoice number is the opposite case and stays firm-wide unique.
  code        String?
  govId       String? // Iqama / national ID / passport no. — whatever identifies them officially
  // Facts a PREREQUISITE can test. A rule could only ever say "another document, valid N months",
  // because there was nothing else on the row to compare against — a minimum-age rule needs a date.
  //
  // Nationality previously lived in `customData["cf-nat"]`, a Form Builder field. It is a column now
  // and that field was retired from the employee form: two places to type the same fact means the rule
  // reads one while the user fills the other, and the check silently passes on an empty value.
  dob         String? // ISO date. Age is derived, never stored — a stored age is wrong within a year.
  // ISO 3166-1 alpha-2, NOT free text. It was a text box with the placeholder "e.g. Saudi", which
  // invites "Saudi", "Saudi Arabian", "KSA" and "saudi" as four different countries. A nationality
  // that four spellings can hide behind is fine as a label and useless as something to count, and a
  // workforce quota that misses a spelling under-reports — the dangerous direction. Comparisons go
  // through resolveCountry(), so a rule written as "Saudi" still matches a row stored as "SA".
  nationality String?
  // Which country's workforce this person counts toward. Usually the employer's, but a group with
  // entities in two countries needs to say which one — an employee counts once, not everywhere.
  workCountry String?
  // Facts a workforce-quota calculation needs and the row did not carry. All nullable: a percentage
  // computed from incomplete data must report how much it could see rather than quietly assume.
  salary         Int?    // monthly, in minor units — see money.ts for why money is never a float
  employmentType String? // full_time | part_time — part-time counts fractionally in some regimes
  jobCategory    String? // skilled | unskilled | … — some regimes count only part of the workforce
  role        String?
  iqamaExpiry String?
  status      String  @default("valid")
  customData  Json? // values for admin-defined custom employee fields (Form Builder / CustomObject)
  archived    Boolean @default(false)
  history     Json? // append-only audit: [{ at, event, detail, by }] — e.g. workflow approved/rejected
  // Offboarding. `archived` stays the FINAL state (every headcount already filters on it); these track
  // the run-up to it. The moment this leaves "active" the renewal engine stops touching their
  // documents — renewing the visa of someone who is leaving is the bug this exists to prevent.
  exitStatus    String  @default("active") // active | exit_requested | exiting | exited
  exitDate      String? // last working day, as declared by the client
  exitReason    String? // resignation | termination | end_of_contract | transfer | other
  exitRequestId String? // the ServiceRequest that tracks the exit

  // Per client, not per system: each client numbers its own staff, so EMP-0002 may exist at several
  // clients at once. Still a real constraint — one client cannot issue the same code twice.
  @@unique([companyId, code])
  @@index([companyId, archived])
  @@index([exitStatus])
}


model Document {
  id               String  @id @default(cuid())
  company          Company @relation(fields: [companyId], references: [id])
  companyId        String
  person           String // display label of the subject (employee name OR company name)
  employeeId       String? // real link when subjectKind = "employee"; null for company-scoped docs
  docType          String
  expiryDate       String?
  status           String  @default("valid")
  daysLeft         Int     @default(0)
  customData       Json? // values for the document type's dynamic fields, keyed by field id
  // Renewal-in-flight pointers, set by the expiry trigger (scheduler). Their real job is IDEMPOTENCY:
  // the trigger runs hourly, so without these it would file a fresh renewal every hour. Cleared when
  // the renewal finishes/cancels, which re-arms the document for a future cycle.
  renewalRunId     String? // WorkflowInstance renewing this doc
  renewalTaskId    String? // plain Task renewing it (when no workflow is bound to the docType)
  docNumber        String? // standard fields (all types)
  issueDate        String?
  issuingAuthority String?
  history          Json? // renewal versions: [{ at, by, oldExpiry, newExpiry, oldNumber, newNumber, fee, receipt, note }]
  // ONE LIVE DOCUMENT PER TYPE PER SUBJECT.
  //
  // A person could hold two passports with different numbers and expiries, and nothing decided which
  // one counted: the prerequisite check, the renewal trigger and the compliance score each ran
  // findFirst and got whichever the database returned first. So the same passport could satisfy a
  // requirement on one screen and fail it on another.
  //
  // Superseded rows are KEPT — the old number and expiry are the audit trail — but every reader
  // filters them out, so exactly one document of a type is authoritative for a subject at a time.
  supersededAt     String? // ISO; null = this is the live one
  supersededById   String? // the document that replaced it, when there is one

  @@index([supersededAt])

  @@index([status])
  @@index([expiryDate])
  @@index([companyId, status])
  @@index([employeeId])
}

// Admin-defined document types with their own dynamic fields + renewal config (no-code).
model DocumentType {
  id                  String  @id @default(cuid())
  // Provenance, for rows that came from a country pack.
  //
  // packKey is the stable identity a pack uses — sa.doctype.iqama — so a re-install recognises this
  // row instead of creating a second one, and an upgrade can find what it is upgrading. Deliberately
  // INDEXED rather than @unique: a unique constraint is the change Prisma refuses without
  // --accept-data-loss, which crash-looped the live API earlier today. The installer enforces
  // uniqueness itself, and pays for that with a check rather than an outage.
  //
  // packModified means a human has edited this since it was installed, so an upgrade must show a diff
  // Retired by a pack uninstall, NOT deleted.
  //
  // A document type with documents captured under it cannot be removed — the documents would lose the
  // definition of their own fields, which is the orphaning this codebase has already been bitten by.
  // So uninstall retires what real records depend on: gone from every picker, still readable, so a
  // two-year-old Iqama still renders with its fields intact.
  retired      Boolean @default(false)
  // rather than overwrite. Null packKey = made here, owned by you, never touched by a pack.
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)
  // Which country this belongs to. Configuration was implicitly Saudi everywhere; with a second
  // country pack installed, an unmarked row appears in every client's pickers regardless of the
  // market they operate in. Nullable for existing rows, backfilled to SA, defaulted on create.
  country       String?
  name                String  @unique
  fields              Json?   @default("[]") // array of { id, label, type, options?, required? }
  prereqs             Json?   @default("[]") // renewal rules: array of { requiresDocType, minMonths }
  leadDays            Int? // reminder lead time — days before expiry the doc flags "expiring" (default 30)
  defaultFee          Int? // default renewal fee (SAR)
  requiresApproval    Boolean @default(false)
  defaultAssigneeRole String? // role a renewal task defaults to
  authority           String? // issuing authority (GDRFA, MOHRE, Qiwa…) shown on the type + its docs
  subjectKind         String  @default("employee") // who the doc belongs to: "employee" (Iqama, visa…) | "company" (CR, GOSI, VAT…)

  @@index([packKey])
}

// Admin-defined custom object/record type (Object Builder) or standalone form (Form Builder), distinguished by `kind`.
model CustomObject {
  id       String  @id @default(cuid())
  name     String
  icon     String? // optional emoji
  fields   Json?   @default("[]") // array of { id, label, type, options?, required? }
  // Only "form" is used. The Object Builder — a no-code record designer whose records had nowhere
  // to be seen outside the builder itself — was removed; this is the Form Builder's storage now.
  kind     String  @default("form")
  appliesTo String @default("") // form-only: "" standalone | "employee" | "client" → fields feed that record's Add form
}

model Task {
  id         String   @id @default(cuid())
  title      String
  company    Company? @relation(fields: [companyId], references: [id])
  companyId  String?
  clientName String?
  assignee   String?
  priority   String   @default("medium")
  dueDate    String?
  status     String   @default("todo")
  docType    String?
  // Government authority this task is submitted to (Qiwa, Muqeem…). The Government Centers screen
  // buckets its queues by this — it was read there but never written by any form until now.
  govCenter  String?
  archived   Boolean  @default(false) // soft-archive; recoverable via the Archived view
  workflowInstanceId String? // set when creating this task also launched a workflow run
  complianceDocId    String? // renewal task → the compliance document it renews (cross-link)
  // The quotation whose acceptance created this task. Also the idempotency key: delivery is started
  // once per quotation, and "has this quotation any tasks?" is the check that stops a second run.
  quotationId        String?
  // The client request whose acceptance created this task. Same role as quotationId above: the
  // provenance of the work, and the idempotency key that stops a request being accepted twice.
  requestId          String?
  employeeId         String? // subject when the task/workflow concerns a specific employee (person docs)
  customData         Json? // values for admin-defined custom task fields (Form Builder → Applies to: Task)
  // Two-phase prerequisite gating: when set, this (Phase-2) task is PARKED waiting on prerequisite
  // workflow run(s). { runIds:[...], resumeWorkflowId?, autoResume, reason }. Cleared when it resumes.
  blockedBy          Json?
  // Human-facing reference (TSK-0001) from the configured record sequence. A task was identified
  // only by its cuid, which nobody can read out over a phone.
  ref                String?

  @@index([status])
  @@index([assignee])
  @@index([companyId, archived])
  @@index([govCenter])
  @@index([quotationId])
  @@index([requestId])
}

model Invoice {
  id         String   @id @default(cuid())
  number     String
  company    Company? @relation(fields: [companyId], references: [id])
  companyId  String?
  clientName String?
  // Whole currency units. DERIVED from totalMinor on every write and kept because reports, the dunning
  // job, the invoice list and the portal all read it — changing its meaning would touch every one of
  // them. `*Minor` below is what the DOCUMENT says; this is a convenience with a single writer.
  amount     Int
  // WHAT THE INVOICE SAYS, FROZEN AT ISSUE.
  //
  // These were computed on the fly at print time instead: the stored total was treated as VAT-inclusive
  // and divided back out. Two consequences, both wrong on a tax document —
  //   · VAT was rounded to whole riyals on save, so re-dividing could not return the original figure:
  //     lines of SAR 250 at 15% saved as 288, then printed a subtotal of SAR 250.43.
  //   · No rate was stored, so changing the Print Layout VAT rate reprinted every past invoice with
  //     different numbers — including the figures inside its ZATCA QR.
  //
  // Minor units (halala) because SAR carries two decimals and `amount Int` could not hold them, which
  // is where the rounding came from in the first place. Integer arithmetic throughout: exact, no floats.
  subtotalMinor  Int? // 25000 = SAR 250.00
  vatMinor       Int?
  totalMinor     Int?
  vatRateBp      Int? // basis points: 1500 = 15.00%. Frozen at issue, never re-read from settings.
  currency   String   @default("SAR")
  status     String   @default("pending")
  date       String?
  dueDate    String?
  services   String?  @db.Text
  // Line items: [{ name, units, price }]. `amount` stays the source of truth for totals/reports and
  // is recomputed from these on save, so existing single-amount invoices keep working untouched.
  items      Json?    @default("[]")
  notes      String?  @db.Text
  // Payment extension / promise-to-pay. While `promisedDate` is in the future the dunning job stops
  // chasing this invoice and it stops counting toward a suspension recommendation — an arrangement
  // the client has actually agreed should not keep generating reminders.
  promisedDate String?
  promisedNote String?
  // Set when this invoice was raised from an accepted quotation, so the two are linked instead of
  // the quote being retyped by hand with nothing tying them together.
  quotationId String?
  // Set when the invoice was raised for a plan add-on, so voiding it knows which add-on it paid
  // for. Without it a void is just an accounting event and the service silently stays free.
  addonServiceId String?
  // Voiding. An issued invoice is never deleted — it stays on file with status "void" and a reason,
  // because a tax document that vanishes is worse than one marked cancelled.
  voidedAt   String?
  voidReason String?

  @@index([status])
  @@index([date])
  @@index([promisedDate])
}

model User {
  id                 String  @id @default(cuid())
  name               String
  email              String  @unique
  passwordHash       String?
  roleId             String  @default("admin")
  status             String  @default("active")
  lastActive         String?
  type               String  @default("staff") // staff | portal
  companyId          String? // for portal users
  phone              String?
  assignedClientIds  Json? // for sales users
  mustChangePassword Boolean @default(false) // portal users must set their own password on first login
  tokenVersion       Int     @default(0) // bump to invalidate all previously issued JWTs
  failedLogins       Int     @default(0) // consecutive failed logins → lockout
  lockedUntil        String? // ISO timestamp; login refused until then
  resetTokenHash     String? // sha256 of the password-reset token
  resetExpires       String? // ISO timestamp the reset token expires
  // Portal notifications are DERIVED from documents/requests/invoices, not stored rows, so there is
  // nothing to flag individually. "Mark all read" records a watermark instead: anything older than
  // this is read. Without it the control could only ever be local state that reset on reload.
  notifReadAt        String?
}

model Audit {
  id         String  @id @default(cuid())
  action     String // e.g. login.success, password.change, credential.reveal
  actorId    String?
  actorEmail String?
  target     String? // what was acted on
  detail     String? @db.Text
  ip         String?
  at         String // ISO timestamp

  @@index([at])
  @@index([actorId])
  @@index([action])
}

model UpgradeRequest {
  id            String   @id @default(cuid())
  company       Company  @relation(fields: [companyId], references: [id])
  companyId     String
  clientName    String
  fromPackageId String?
  toPackageId   String?
  note          String?  @db.Text
  status        String   @default("pending")
  date          String?
  // "package" = move the client to another tier (the original flow).
  // "addon"   = unlock ONE service on top of the tier they already have. Same review queue, so staff
  //             see both kinds in one place instead of a second inbox.
  kind        String  @default("package")
  serviceId   String? // addon only — the ServiceItem being requested
  serviceName String? // snapshot, so the queue still reads correctly if the catalog item is renamed
  quotedPrice Int? // addon only — set by staff at approval; the client never sees a price before that

  @@index([status])
  @@index([kind])
}

model SiteCredential {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id])
  companyId String
  label     String
  url       String
  username  String?
  password  String // NOTE: encrypt at rest in production
  notes     String? @db.Text
  // Which government portal this login is for, so a step that names an authority can point straight
  // at the right credential instead of leaving the officer to search the vault by client and guess
  // from the label. DECLARED, not inferred: matching "Qiwa" against a free-text label is the same
  // guess-presented-as-fact that had the Services list showing workflows it would never run.
  govCenter String?

  @@index([govCenter])
}

model Activity {
  id      String  @id @default(cuid())
  type    String
  message String? @db.Text
  user    String?
  time    String?
  date    String?

  @@index([date])
}

model ServiceRequest {
  id         String  @id @default(cuid())
  // Reference (REQ-0001) from the configured record sequence. Both apps used to display
  // "SRV-" + the last four characters of the cuid — a label derived from a database id, which
  // nobody can quote back and which is not unique in any meaningful sense.
  number     String?
  companyId  String?
  clientName String?
  type       String?
  message    String? @db.Text // the client's opening message; the thread lives in ServiceRequestMessage
  // open | accepted | resolved | rejected — a client reply reopens it.
  //
  // `accepted` exists because "approve" used to write "resolved": the vocabulary said the work was
  // FINISHED at the moment it was agreed, and there was no state for the part in between, which is
  // where a request spends nearly all of its life.
  status     String  @default("open")
  date       String?
  // What accepting this request produced. Null while open; both set together when work starts, and
  // workflowInstanceId stays null when the service has no template bound (ten of fourteen today).
  taskId             String?
  workflowInstanceId String?
  serviceItemId      String? // the catalogue service that was agreed — may differ from the typed `type`
  acceptedAt         String?
  rejectedReason     String? // shown to the client; rejecting used to say nothing at all
  // Unread is derived from these rather than a per-user read table — two timestamps per side is
  // enough at this scale and keeps the bell query trivial.
  lastClientMsgAt String?
  lastStaffMsgAt  String?
  staffReadAt     String?
  clientReadAt    String?

  @@index([companyId])
  @@index([status])
}

// One message in a request's thread. `internal` notes are staff-only and are filtered out of every
// portal response — that filtering is the whole point, so it lives server-side, never in the client.
// A file the client attached to a request, against the document it is meant to be.
//
// The attachment used to be a LINE OF TEXT: the uploader glued "Attachment: http://…/files/x.pdf"
// onto the end of the request message. So nothing knew which document a file was, several files
// could not be told apart, and the workflow's collect step could not tick anything off — the officer
// asked the client again for papers already sitting in the request.
//
// `docKey` matches a key in ServiceItem.requiredDocs; "other" holds the extras the client adds.
model RequestAttachment {
  id        String  @id @default(cuid())
  requestId String
  docKey    String  @default("other")
  label     String?
  path      String // /files/<name>
  name      String? // the client's own filename, for display
  size      Int     @default(0)
  at        String?

  @@index([requestId])
}

model ServiceRequestMessage {
  id         String  @id @default(cuid())
  requestId  String
  authorType String  @default("staff") // "staff" | "client"
  authorName String?
  body       String  @db.Text
  internal   Boolean @default(false)
  at         String?

  @@index([requestId])
}


model Notification {
  id      String  @id @default(cuid())
  type    String
  title   String
  message String? @db.Text
  time    String?
  // Real ISO timestamp. `time` is only a display string (everything said "Just now" forever) and the
  // id is a cuid, so there was nothing to compare a per-user read watermark against. Nullable because
  // rows written before this existed have no honest value — those are treated as already read.
  createdAt String?
  read    Boolean @default(false)
  // Set by automated jobs so a repeating tick can't repeat a notification. Unique — the insert is the
  // dedupe (no read-then-write race). Null for human-generated notifications, which may legitimately repeat.
  dedupeKey String? @unique

  @@index([read])
}

// ── BPM Workflow engine ──────────────────────────────────────────────
// A reusable process definition. The DAG lives in `graph` as { nodes:[], edges:[] }.
// node  = { id, type, label, config }   type: start|task|approval|decision|parallel_split|parallel_join|notify|webhook|delay|end
// edge  = { id, from, to, label?, condition? }   condition routes decision/approval outcomes (e.g. "approve","reject","<branchKey>","else")
model WorkflowTemplate {
  id            String             @id @default(cuid())
  // Provenance, for rows that came from a country pack.
  //
  // packKey is the stable identity a pack uses — sa.doctype.iqama — so a re-install recognises this
  // row instead of creating a second one, and an upgrade can find what it is upgrading. Deliberately
  // INDEXED rather than @unique: a unique constraint is the change Prisma refuses without
  // --accept-data-loss, which crash-looped the live API earlier today. The installer enforces
  // uniqueness itself, and pays for that with a check rather than an outage.
  //
  // packModified means a human has edited this since it was installed, so an upgrade must show a diff
  // Retired by a pack uninstall, NOT deleted.
  //
  // A document type with documents captured under it cannot be removed — the documents would lose the
  // definition of their own fields, which is the orphaning this codebase has already been bitten by.
  // So uninstall retires what real records depend on: gone from every picker, still readable, so a
  // two-year-old Iqama still renders with its fields intact.
  retired      Boolean @default(false)
  // rather than overwrite. Null packKey = made here, owned by you, never touched by a pack.
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)
  // Which country this belongs to. Configuration was implicitly Saudi everywhere; with a second
  // country pack installed, an unmarked row appears in every client's pickers regardless of the
  // market they operate in. Nullable for existing rows, backfilled to SA, defaulted on create.
  country       String?
  name          String
  description   String?            @db.Text
  trigger       String             @default("manual") // manual | document_expiry | request_intake
  triggerConfig Json? // { docType, days } etc.
  entityType    String             @default("generic") // visa | company_formation | ...
  graph         Json               @default("{\"nodes\":[],\"edges\":[]}")
  version       Int                @default(1)
  active        Boolean            @default(false)
  createdAt     String?
  instances     WorkflowInstance[]

  @@index([packKey])
}

// A running (or finished) execution of a template over one subject (a visa request, a client, etc.).
model WorkflowInstance {
  id          String           @id @default(cuid())
  template    WorkflowTemplate @relation(fields: [templateId], references: [id])
  templateId  String
  title       String
  companyId   String?
  clientName  String?
  variables   Json?            @default("{}") // process variables (country, visaType, passportValid, …) incl. engine bookkeeping keys prefixed with _
  status      String           @default("running") // running | completed | cancelled | failed
  startedAt   String?
  completedAt String?
  tasks       WorkflowTask[]
  logs        WorkflowLog[]

  @@index([companyId])
  @@index([status])
}

// A unit of human work produced by a task/approval node. The engine waits on these.
model WorkflowTask {
  id           String           @id @default(cuid())
  instance     WorkflowInstance @relation(fields: [instanceId], references: [id])
  instanceId   String
  nodeId       String // originating graph node
  nodeType     String           @default("task") // task | approval
  title        String
  assignee     String? // optional specific person
  assigneeRole String? // role gate — who may complete it
  status       String           @default("active") // active | done | approved | rejected | skipped
  priority     String           @default("medium")
  dueDate      String?
  slaHours     Int?
  // What the person doing this step is supposed to do. SNAPSHOTTED from the node when the step is
  // created, for the same reason the checklist is: editing the template must not rewrite the
  // instructions someone is already working from. There was no field for this at all, so
  // "Verify passport validity" was the entire brief a new officer got.
  instructions String?            @db.Text
  // A document this step must SEE and CHECK before it can be completed: { docType, minMonths }.
  // Snapshotted at creation like the checklist and the instructions, so editing the template cannot
  // change the rule someone is already being held to. Steps could collect a document type's fields
  // and write them back, but could never look at an existing document and refuse — so "verify the
  // passport has six months left" was a label, not a control.
  verifyRule   Json?
  checklist    Json? // resolved item defs snapshot: [{ key, label, required }] (also accepts legacy [{label,done}])
  checklistState Json? // per-item runtime state: { [key]: { received, verified, note?, fileRef? } }
  requireVerification Boolean @default(false) // completion needs each required item received AND verified
  captures     Json? // [{ var, label, type, options? }] — variables the completer must set
  outcome      String? // approval: approve|reject ; task with branches: chosen key
  completedBy  String?
  completedAt  String?
  createdAt    String? // when the step became active — for SLA elapsed calc
  // SLA escalation bookkeeping. `slaState` is the last state the escalator ACTED on, so it only fires
  // on a real transition (on_track→at_risk→breached) instead of re-notifying every hourly tick.
  slaState     String? // null (never evaluated) | on_track | at_risk | breached
  escalatedAt  String?
  // Which authority this step is carried out at, snapshotted from the node like the instructions.
  // The portal used to live only on the parent Task — one value per case — so a cancellation that
  // runs through Qiwa, Muqeem and GOSI could name just one of them, and the Government Centers queue
  // could only ever list whole cases rather than the jobs waiting at each authority.
  govCenter    String?

  @@index([status])
  @@index([assigneeRole])
  @@index([govCenter])
}

// Admin-defined rule that maps instance variables → a document set (dynamic per-client checklists).
// rows: [{ conditions: [{ var, op, value }], documents: [{ key, label, required }] }] — union of matching rows.
/// A nationalisation band for one country — Nitaqat's Platinum/Green/Yellow/Red, Emiratisation's
/// equivalents, whatever a market calls them.
///
/// These are CONFIGURATION, not code. They were four names hard-coded in the console, which meant the
/// band could only ever be a fact somebody read off a government portal and typed in — the app had no
/// way to work it out, and a second country could not have different bands at all.
///
/// With the thresholds recorded here the ratio decides the band directly. The thresholds are the
/// firm's own data: whoever enters them is asserting what the regulator publishes, which is a very
/// different thing from this codebase guessing at them.
///
/// Carries the same provenance columns as every other config model so a band set travels in a country
/// pack and can be upgraded, retired and uninstalled like anything else.
model WorkforceBand {
  id           String  @id @default(cuid())
  country      String?
  name         String
  /// Text and background, so a band reads the same everywhere it appears.
  color        String?
  bg           String?
  /// Inclusive floor and exclusive ceiling, in BASIS POINTS — 3333 = 33.33%. Integers for the same
  /// reason money is: a percentage held as a float puts a client on the wrong side of a boundary.
  /// `maxBp` null means "and above", so the top band needs no invented upper limit.
  minBp        Int
  maxBp        Int?
  /// Lowest first. Two bands that overlap are a configuration error the editor refuses to save.
  sort         Int     @default(0)
  retired      Boolean @default(false)
  packKey      String?
  packVersion  String?
  packModified Boolean @default(false)

  @@index([packKey])
  @@index([country])
}

