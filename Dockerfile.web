# STIMES PRO — console + portal (static), served by nginx.
#
# Both front ends are built from the same repo and shipped in one image; nginx picks between them by
# Host header, so Traefik points pro.* and cp.* at the same container.
#
# API_URL is a BUILD ARG because the front ends have it compiled in: build-deploy.mjs injects
# `window.STIMES_API` into the HTML. That means an image is bound to one API origin — rebuild with a
# different --build-arg to target staging.
FROM node:22-bookworm-slim AS build
WORKDIR /src

ARG API_URL=https://proapi.ionob.in

# pnpm, not npm: the repo root ships pnpm-lock.yaml and no package-lock.json, so `npm ci` would
# fail outright here. (server/ is the opposite — it has package-lock.json, which is why the API
# image uses npm.) corepack ships with Node 22 and pins pnpm without a global install.
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# vite build → dist/, then build-deploy.mjs stages deploy/console and deploy/portal with the API
# origin injected and portal.html renamed to index.html.
RUN npx vite build && API_URL="${API_URL}" node scripts/build-deploy.mjs

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/deploy/console/ /usr/share/nginx/html/console/
COPY --from=build /src/deploy/portal/  /usr/share/nginx/html/portal/

# The .htaccess in each folder is for the Apache host and means nothing here — nginx.conf carries the
# equivalent try_files rule. Removed so it cannot be mistaken for live configuration.
RUN rm -f /usr/share/nginx/html/console/.htaccess /usr/share/nginx/html/portal/.htaccess

EXPOSE 80
